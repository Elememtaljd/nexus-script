            TextYAlignment = Enum.TextYAlignment.Top,
            ZIndex = 5,
            Parent = Back
        })

        local Progress: Frame = Create.New("Frame", {
            Position = UDim2.new(0, 3, 1, -4),
            Size = UDim2.new(1, -13, 0, 1),
