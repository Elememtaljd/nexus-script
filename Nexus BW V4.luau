local ok, runtimeError = xpcall(run, function(err)
    if type(debug) == "table" and type(debug.traceback) == "function" then
        return tostring(err) .. "\n" .. debug.traceback()
    end
    return tostring(err)
end)
if not ok then error("[CatVape] Embedded BedWars code failed: " .. tostring(runtimeError)) end
print("[CatVape] Embedded BedWars bundle launched.")

local overlayRun, overlayProblem = loadstring(restoredOverlaysSource, "@bedwars/restored-overlays")
if overlayRun then
    task.spawn(function()
        local success, issue = pcall(overlayRun)
        if not success then warn("[CV overlays] Restored overlays failed: " .. tostring(issue)) end
    end)
else
    warn("[CV overlays] Restored overlays did not compile: " .. tostring(overlayProblem))
end
