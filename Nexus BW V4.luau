    warn("[CatVape] This source targets BedWars (GameId " .. TARGET_GAME_ID .. "). Current GameId: " .. tostring(game.GameId))
    return
end
if type(loadstring) ~= "function" then
    error("[CatVape] Executor must provide loadstring for the bundled Luau modules.")
end

local function fileExists(path)
    if type(isfile) == "function" then
        local ok, result = pcall(isfile, path)
        if ok then return result == true end
    end
    if type(readfile) == "function" then
        local ok, contents = pcall(readfile, path)
        return ok and type(contents) == "string" and #contents > 0
    end
    return false
end

local function ensureFolder(path)
    if type(isfolder) == "function" then
        local ok, exists = pcall(isfolder, path)
        if ok and exists then return true end
    end
    if type(makefolder) ~= "function" then return false end
    local ok = pcall(makefolder, path)
    return ok
end

local function decodeBase64(raw)
    local ok, data = pcall(function()
        return buffer.tostring(game:GetService("EncodingService"):Base64Decode(buffer.fromstring(raw)))
    end)
    if ok and type(data) == "string" then return data end
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for index = 1, #alphabet do map[alphabet:byte(index)] = index - 1 end
    local out, count = {}, 0
    for i = 1, #raw, 4 do
        local x, y = map[raw:byte(i)], map[raw:byte(i+1)]
        local z, w = map[raw:byte(i+2)], map[raw:byte(i+3)]
        if x == nil or y == nil then error("Invalid base64 asset") end
        local bits = x * 262144 + y * 4096 + (z or 0) * 64 + (w or 0)
        count += 1
        if z == nil then
            out[count] = string.char(math.floor(bits / 65536) % 256)
        elseif w == nil then
            out[count] = string.char(math.floor(bits / 65536) % 256, math.floor(bits / 256) % 256)
        else
            out[count] = string.char(math.floor(bits / 65536) % 256, math.floor(bits / 256) % 256, bits % 256)
        end
    end
    return table.concat(out)
end

