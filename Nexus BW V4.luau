local Tween = BundledModules.Tween

return function(Ui: Context): (Title: string, Text: string?, Duration: number?, Type: string?, Reuse: string?) -> ()
    local List: {Notice} = {}
    local Cache: {[string]: Notice} = {}

    local function Reflow()
        local Offset: number = 32
        for _, v: Notice in List do
            Offset += v.Height
            if v.Object.Position.Y.Offset ~= 0 then
                Tween(v.Object, Theme.Slide, {Position = UDim2.new(1, 0, 1, -Offset)})
            else
                v.Object.Position = UDim2.new(1, 0, 1, -Offset)
            end
            Offset += 3
        end
    end

    local function Build(): Notice
        local Object: ImageLabel = Create.New("ImageLabel", {
            BackgroundTransparency = 1,
            Image = Ui:Icon("notification"),
            Position = UDim2.new(1, 0, 1, 0),
            ScaleType = Enum.ScaleType.Slice,
            SliceCenter = Rect.new(7, 7, 9, 9),
            ZIndex = 5,
            Parent = Ui.Notices
        })

        Create.New("ImageLabel", {
            BackgroundTransparency = 1,
            Image = Ui:Icon("blurnoti"),
            Position = UDim2.fromOffset(-48, -31),
            ScaleType = Enum.ScaleType.Slice,
            SliceCenter = Rect.new(52, 31, 261, 502),
