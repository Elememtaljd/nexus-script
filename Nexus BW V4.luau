            end
        end
    })
end)()

BundledModules.HitFix = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services
    local LocalPlayer: Player = Services.Players.LocalPlayer

    local Hitreg = BundledModules.Hitreg

    local HitFix

    local Constant: number?
    local Upvalue: number?
    local Original: ((...any) -> ...any)? = nil
    local Lock: LockState = Hitreg.Lock.new()

    HitFix = Cat.Legit:CreateModule({
        Name = "HitFix",
        Category = "Game",
        Icon = "legit_hitfix",
        Function = function(Callback: boolean)
            local Sword: any = Data.Controllers.SwordController
            if not Constant or not Upvalue then
                for i: number, v: any in debug.getconstants(Sword.swingSwordAtMouse) do
                    if v == "Raycast" or v == "raycast" then
                        Constant = i

                        break
                    end
                end

                for i: number, v: any in debug.getupvalues(Sword.swingSwordAtMouse) do
                    if v == workspace or v == Data.Controllers.GameQueryUtil then
                        Upvalue = i

                        break
                    end
                end
            end

            if Constant and Upvalue then
                debug.setconstant(Sword.swingSwordAtMouse, Constant, Callback and "raycast" or "Raycast")
                debug.setupvalue(Sword.swingSwordAtMouse, Upvalue, Callback and Data.Controllers.GameQueryUtil or workspace)
            end

            if Callback then
                local Old: (...any) -> ...any = Sword.attackEntity
                local Speed: number = Hitreg.Constants.Stock
                local Hit: number = 0
                local Pending: {any}? = nil
                Original = Old
                Lock:Reset()
                Lock.Space = 10 / 36

                local Shorten: any = Data.Instances.SyncEvents.SwordSwing:setPriority(150):connect(function(Event: any)
                    Speed = Event.attackSpeed
                    if math.abs(Event.attackSpeed - Hitreg.Constants.Stock) < 0.001 then
                        Event.attackSpeed = Hitreg.Constants.Lock.Floor
                    end
                end)
                local Restore: any = Data.Instances.SyncEvents.SwordSwing:setPriority(300):connect(function(Event: any)
                    Event.attackSpeed = Speed
                end)
                HitFix:Clean(function()
                    Shorten:Destroy()
                    Restore:Destroy()
                    Pending = nil
                end)

                HitFix:Clean(Services.RunService.Heartbeat:Connect(function(Delta: number)
                    Lock.Frame = Delta
                end))
                HitFix:Clean(Data.Events.EntityDamageEvent:Connect(function(Event: {entityInstance: Model?, damageType: number, fromEntity: Model?})
                    local Stamp: any = Event.fromEntity == LocalPlayer.Character and Event.damageType == 0 and Event.entityInstance and Event.entityInstance:GetAttribute("LastDamageTakenTime")
                    if type(Stamp) == "number" then
                        Lock:Learn(Stamp)
                    end
                end))

                Sword.attackEntity = function(self: any, ...: any): ...any
                    local Stock: boolean = math.abs(Speed - Hitreg.Constants.Stock) < 0.001
                    if not Stock or LocalPlayer:GetNetworkPing() >= Hitreg.Constants.Lock.Ping then
                        Hit = tick()
                        return Old(self, ...)
                    end

                    local Remaining: number = Lock:Spin(Lock:Remaining(Hit, tick(), os.clock()))
                    if Remaining <= 0 then
                        Hit = tick()
                        Lock.Space = 10 / 36
                        Lock:Record(os.clock(), Services.Workspace:GetServerTimeNow())
                        return Old(self, ...)
                    end

                    local Waiting: boolean = Pending ~= nil
                    Pending = table.pack(self, ...)
                    if not Waiting then
                        task.delay(math.max(Remaining - Lock.Frame, 0), function()
                            repeat
                                Remaining = Lock:Spin(Lock:Remaining(Hit, tick(), os.clock()))
                                if Remaining > 0 then
                                    Services.RunService.Heartbeat:Wait()
                                end
                            until Remaining <= 0 or not Pending

                            local Args: {any}? = Pending
                            Pending = nil
                            if Args and HitFix.Enabled and Sword.attackEntity ~= Old then
                                Hit = tick()
                                Lock.Space = 10 / 36
                                Lock:Record(os.clock(), Services.Workspace:GetServerTimeNow())
                                Old(table.unpack(Args, 1, Args.n))
                            end
                        end)
                    end

                    return nil
                end
            elseif Original then
                Sword.attackEntity = Original
                Original = nil
            end
        end,
        Tooltip = "Lines your hits up with the game's own raycast, and times every normal attack to land on the server's hit window so you get nominally 36 hits every 10 seconds (server validation still applies)"
    })
end)()

