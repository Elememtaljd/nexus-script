BundledModules.PickUpRange = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services

    local Entity = BundledModules.Entity

    local PickUpRange
    local Range, Lower

    local Picked: {[BasePart]: boolean} = {}

    PickUpRange = Cat.Categories.Utility:CreateModule({
        Name = "PickUpRange",
        Function = function(Callback: boolean)
            if Callback then
                repeat
                    if Entity.Alive then
                        local LocalPosition: Vector3 = Entity.RootPart.Position
                        for _, v in Services.CollectionService:GetTagged("ItemDrop") do
                            if v:IsA("BasePart") and not Picked[v] and tick() - (v:GetAttribute("ClientDropTime") or 0) >= 2 then
                                if (LocalPosition - v.Position).Magnitude <= Range.Value and (not Lower.Enabled or LocalPosition.Y - v.Position.Y >= Entity.Humanoid.HipHeight - 1) then
                                    Picked[v] = true
                                    Data.Controllers.ClientScript:Get("PickupItemDrop"):CallServerAsync({itemDrop = v}):andThen(function(Success: boolean)
                                        Picked[v] = nil

                                        if not Success then
                                            return
                                        end

                                        Data.Controllers.AudioManager:playAudio(Data.Instances.Sounds.PICKUP_ITEM_DROP)

                                        local Meta: any = Data.Instances.Items[v.Name]
                                        if Meta and Meta.pickUpOverlaySound then
                                            Data.Controllers.AudioManager:playAudio(Meta.pickUpOverlaySound, {
                                                position = v.Position,
                                                volumeMultiplier = 0.9
                                            })
                                        end
                                    end)
                                end
                            end
                        end
                    end

                    task.wait(0.1)
                until not PickUpRange.Enabled
            else
                table.clear(Picked)
            end
        end,
        Tooltip = "Picks up items from a farther distance"
    })

    Range = PickUpRange:CreateSlider({
        Name = "Range",
        Min = 1,
        Max = 10,
        Default = 10,
        Suffix = function(Value: number)
            return Value == 1 and "stud" or "studs"
        end
    })
    Lower = PickUpRange:CreateToggle({Name = "Feet Check"})
end)()

BundledModules.Scaffold = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services

    local Entity = BundledModules.Entity
    local Drag = BundledModules.Drag
    local PlacementController = BundledModules.PlacementController
    -- Nexus AutoBlockUp uses the existing Block up placement system without
    -- requiring the user to hold Space or jump first. Normal Scaffold is unchanged.
    local NexusAutoBlockEnvironment = (type(getgenv) == "function" and getgenv()) or _G

    local Scaffold
    local Expand, Tower, TowerMode, Downwards, Diagonal, LimitItem, Mouse, FillColor, OutlineColor, HudPosition

    local Hud: Frame?
    local HudParts: {[string]: any} = {}
    local HudTweens: {Tween} = {}
    local HudConnection: RBXScriptConnection?
    local HudBlock: string?
    local HudRatio: number, HudPeak: number, HudLast: number, HudSpeed: number, HudTime: number = 0, 0, 0, 0, os.clock()
    local Visual: Part?
    local VisualTween: Tween?
    local VisualPosition: Vector3?
    local LastPosition: Vector3 = Vector3.zero
    local LastClimb: Vector3?, ClimbTime: number = nil, 0
    local Grounded: Humanoid?

    local isnetworkowner = isnetworkowner or function(_): boolean
        return true
    end

    local function Climb(Block: string)
        local Store: any = Data.Controllers.BlockController:getStore()
        local Feet: number = Entity.RootPart.Position.Y - Entity.Humanoid.HipHeight - Entity.RootPart.Size.Y / 2
        local Cell: Vector3 = Data.Controllers.BlockController:getBlockPosition(Vector3.new(Entity.RootPart.Position.X, Feet - 1.5, Entity.RootPart.Position.Z))
        repeat
            local Taken: boolean = Store:getBlockAt(Cell) ~= nil
            if Taken then
                Cell += Vector3.yAxis
            end
        until not Taken or Cell.Y * 3 - 1.5 > Feet + 3

        if Entity.Humanoid.MoveDirection.Magnitude < 0.1 and Entity.Humanoid.FloorMaterial ~= Enum.Material.Air and isnetworkowner(Entity.RootPart) then
            Entity.RootPart.CFrame = CFrame.new(Cell.X * 3, Entity.RootPart.Position.Y, Cell.Z * 3) * Entity.RootPart.CFrame.Rotation
        end

        local Anchored: boolean = false
        for _, v: Vector3 in {-Vector3.yAxis, Vector3.xAxis, -Vector3.xAxis, Vector3.zAxis, -Vector3.zAxis} do
            if Store:getBlockAt(Cell + v) then
                Anchored = true

                break
            end
        end

        local Now: number = Services.Workspace:GetServerTimeNow()
        local Ready: boolean = Now - Data.Controllers.BlockCpsController.lastPlaceTimestamp >= 1 / Data.Instances.CPSConstants.BLOCK_PLACE_CPS
        local Clear: boolean = not Store:getBlockAt(Cell) and not Store:getBlockAt(Cell + Vector3.yAxis) and not Store:getBlockAt(Cell + Vector3.yAxis * 2)
        if Anchored and Ready and Clear and Cell.Y * 3 - 1.5 <= Feet + 0.15 and (Cell ~= LastClimb or Now - ClimbTime >= 0.5) then
            LastClimb, ClimbTime = Cell, Now
            task.spawn(PlacementController.Place, Cell * 3, Block)
        end
    end

    local function GetBlock(): (string?, number)
        if Data.Storage.Hand.Type == "block" and Data.Storage.Hand.Tool then
            return Data.Storage.Hand.Tool.Name, Data.Storage.Hand.Amount
        end
        if LimitItem.Enabled then
            return nil, 0
        end

        for _, v: InventoryItem in (Data.Storage.Inventory.inventory.items or {}) do
            if v.itemType:find("wool") then
                return v.itemType, v.amount
            end
        end
        for _, v: InventoryItem in (Data.Storage.Inventory.inventory.items or {}) do
            if Data.Instances.Items[v.itemType] and Data.Instances.Items[v.itemType].block then
                return v.itemType, v.amount
            end
        end

        return nil, 0
    end

    local function BuildHud()
        HudRatio = 0

        local X: string?, Y: string? = HudPosition.Value:match("^(%-?%d+),(%-?%d+)$")
        local Frame: Frame = Instance.new("Frame")
        Frame.Size = UDim2.fromOffset(300, 44)
        Frame.Position = UDim2.new(0.5, tonumber(X) or 0, 0.5, tonumber(Y) or 60)
        Frame.AnchorPoint = Vector2.new(0.5, 0)
        Frame.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
        Frame.BackgroundTransparency = 0.45
        Frame.BorderSizePixel = 0
        Frame.Visible = Scaffold.Enabled or Cat.Ui.Click.Visible
        Drag(Frame, function(Object: GuiObject)
            HudPosition:SetValue(`{math.round(Object.Position.X.Offset)},{math.round(Object.Position.Y.Offset)}`)
        end)

        local Badge: Frame = Instance.new("Frame")
        Badge.Size = UDim2.fromOffset(32, 32)
        Badge.Position = UDim2.new(0, 6, 0.5, 0)
        Badge.AnchorPoint = Vector2.new(0, 0.5)
        Badge.BackgroundTransparency = 0.7
        Badge.BorderSizePixel = 0
        Badge.Parent = Frame

        local Icon: ImageLabel = Instance.new("ImageLabel")
        Icon.Size = UDim2.fromOffset(22, 22)
        Icon.Position = UDim2.fromScale(0.5, 0.5)
        Icon.AnchorPoint = Vector2.new(0.5, 0.5)
        Icon.BackgroundTransparency = 1
        Icon.Parent = Badge

        local Track: Frame = Instance.new("Frame")
        Track.Size = UDim2.fromOffset(150, 4)
        Track.Position = UDim2.new(0, 48, 0.5, 0)
        Track.AnchorPoint = Vector2.new(0, 0.5)
        Track.BackgroundColor3 = Color3.new(1, 1, 1)
        Track.BackgroundTransparency = 0.85
        Track.BorderSizePixel = 0
        Track.Parent = Frame

        local Trail: Frame = Instance.new("Frame")
        Trail.Size = UDim2.fromScale(0, 1)
        Trail.BackgroundTransparency = 0.6
        Trail.BorderSizePixel = 0
        Trail.Parent = Track

        local Fill: Frame = Instance.new("Frame")
        Fill.Size = UDim2.fromScale(0, 1)
        Fill.ZIndex = 2
        Fill.BorderSizePixel = 0
        Fill.Parent = Track

        local Count: TextLabel = Instance.new("TextLabel")
        Count.Size = UDim2.fromOffset(100, 22)
        Count.Position = UDim2.fromOffset(214, 9)
        Count.BackgroundTransparency = 1
        Count.Text = "0 blocks"
        Count.TextColor3 = Color3.new(1, 1, 1)
        Count.TextSize = 16
        Count.TextXAlignment = Enum.TextXAlignment.Left
        Count.RichText = true
        Count.Parent = Frame

        local Rate: TextLabel = Instance.new("TextLabel")
        Rate.Size = UDim2.fromOffset(100, 15)
        Rate.Position = UDim2.fromOffset(214, 25)
        Rate.BackgroundTransparency = 1
        Rate.Text = "0.0 b/s"
        Rate.TextColor3 = Color3.fromRGB(150, 150, 158)
        Rate.TextSize = 12
        Rate.TextXAlignment = Enum.TextXAlignment.Left
        Rate.Parent = Frame

        for _, v: GuiObject in {Frame, Badge, Track, Trail, Fill} do
            local Corner: UICorner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(1, 0)
            Corner.Parent = v
        end

        Frame.Parent = Cat.Ui.Gui
        Hud = Frame
        HudParts = {Badge = Badge, Icon = Icon, Trail = Trail, Fill = Fill, Count = Count, Rate = Rate}
    end

    local function UpdateHud(Block: string?, Count: number)
        if Hud then
            local Now: number = os.clock()
            local Delta: number = math.max(Now - HudTime, 0.001)
            if Block ~= HudBlock then
                HudBlock, HudPeak, HudLast = Block, 0, Count
                HudParts.Icon.Image = Block and Data.Instances.Items[Block] and Data.Instances.Items[Block].image or ""
            end

            HudSpeed += (math.max(HudLast - Count, 0) / Delta - HudSpeed) * math.min(Delta * 0.5, 1)
            HudPeak, HudLast, HudTime = math.max(HudPeak, Count), Count, Now

            local Accent: Color3 = Cat.Ui:Color(0)
            if HudParts.Fill.BackgroundColor3 ~= Accent then
                HudParts.Badge.BackgroundColor3, HudParts.Trail.BackgroundColor3, HudParts.Fill.BackgroundColor3 = Accent, Accent, Accent
            end

            local Ratio: number = HudPeak > 0 and Count / HudPeak or 0
            if Ratio ~= HudRatio then
                local Drain: boolean = Ratio < HudRatio
                HudRatio = Ratio
                for _, v: Tween in HudTweens do
                    v:Cancel()
                end

                local Fill: Tween = Services.TweenService:Create(HudParts.Fill, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.fromScale(Ratio, 1)})
                local Trail: Tween = Services.TweenService:Create(HudParts.Trail, TweenInfo.new(Drain and 0.45 or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, Drain and 0.2 or 0), {Size = UDim2.fromScale(Ratio, 1)})
                Fill:Play()
                Trail:Play()
                HudTweens = {Fill, Trail}
            end

            HudParts.Count.Text = `<font color="#{Accent:ToHex()}">{Count}</font> {Count == 1 and "block" or "blocks"}`
            HudParts.Rate.Text = string.format("%.1f b/s", HudSpeed)

            local Width: number = 214 + math.ceil(math.max(HudParts.Count.TextBounds.X, HudParts.Rate.TextBounds.X)) + 14
            if Hud.Size.X.Offset ~= Width then
                Hud.Size = UDim2.fromOffset(Width, 44)
            end
        end
    end

    local function ShowHud()
        if not Hud then
            return
        end

        Hud.Visible = Scaffold.Enabled or Cat.Ui.Click.Visible
        if Hud.Visible and not Scaffold.Enabled then
            UpdateHud(GetBlock())
        end
    end

    local function HideVisual()
        if VisualTween then
            VisualTween:Cancel()
            VisualTween = nil
        end
        if Visual then
            Visual.Parent = nil
        end

        VisualPosition = nil
    end

    Scaffold = Cat.Categories.Utility:CreateModule({
        Name = "Scaffold",
        Function = function(Callback: boolean)
            if Hud then
                Hud.Visible = Callback or Cat.Ui.Click.Visible
            end
            if Callback then
                HudBlock, HudSpeed = nil, 0
                repeat
                    if Entity.Alive then
                        local Block: string?, Amount: number = GetBlock()
                        UpdateHud(Block, Amount)
                        if Mouse.Enabled and not Services.UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                            Block = nil
                        end

                        if Block then
                            local Rising: boolean = Tower.Enabled
                                and (Services.UserInputService:IsKeyDown(Enum.KeyCode.Space) or NexusAutoBlockEnvironment.__NexusAutoBlockUpActive == true)
                                and not Services.UserInputService:GetFocusedTextBox()
                            if Rising and TowerMode.Value == "Block up" then
                                if Grounded ~= Entity.Humanoid then
                                    Grounded = Entity.Humanoid
                                    Entity.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
                                end

                                Climb(Block)
                            elseif Rising then
                                Entity.RootPart.AssemblyLinearVelocity = Vector3.new(Entity.RootPart.AssemblyLinearVelocity.X, 38, Entity.RootPart.AssemblyLinearVelocity.Z)
                            end

                            for Step: number = Expand.Value, 1, -1 do
                                local Drop: number = Entity.Humanoid.HipHeight + (Downwards.Enabled and Services.UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 4.5 or 1.5)
                                local Raw: Vector3 = Entity.RootPart.Position - Vector3.new(0, Drop, 0) + Entity.Humanoid.MoveDirection * (Step * 3)
                                local Position: Vector3 = Vector3.new(math.round(Raw.X / 3) * 3, math.round(Raw.Y / 3) * 3, math.round(Raw.Z / 3) * 3)
                                if Diagonal.Enabled and math.abs(math.round(math.deg(math.atan2(-Entity.Humanoid.MoveDirection.X, -Entity.Humanoid.MoveDirection.Z)) / 45) * 45) % 90 == 45 then
                                    local Delta: Vector3 = LastPosition - Position
                                    if ((Delta.X == 0 and Delta.Z ~= 0) or (Delta.X ~= 0 and Delta.Z == 0)) and ((LastPosition - Entity.RootPart.Position) * Vector3.new(1, 0, 1)).Magnitude < 2.5 then
                                        Position = LastPosition
                                    end
                                end

                                if Visual then
                                    local Target: Vector3 = Data.Controllers.BlockController:getBlockPosition(Position) * 3
                                    if VisualPosition ~= Target then
                                        if VisualTween then
                                            VisualTween:Cancel()
                                        end

                                        if Visual.Parent == Services.Workspace.CurrentCamera then
                                            VisualTween = Services.TweenService:Create(Visual, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = CFrame.new(Target)})
                                            VisualTween:Play()
                                        else
                                            Visual.CFrame = CFrame.new(Target)
                                            Visual.Parent = Services.Workspace.CurrentCamera
                                        end

                                        VisualPosition = Target
                                    end
                                end

                                local Grid: Vector3 = Data.Controllers.BlockController:getBlockPosition(Position)
                                if not Data.Controllers.BlockController:getStore():getBlockAt(Grid) then
                                    local Touching: boolean = false
                                    for _, v: Vector3 in PlacementController.Offsets do
                                        if Data.Controllers.BlockController:getStore():getBlockAt(Data.Controllers.BlockController:getBlockPosition(Grid * 3 + v)) then
                                            Touching = true

                                            break
                                        end
                                    end

                                    local Anchor: Vector3? = Touching and Grid * 3 or PlacementController.Nearest(Position)
                                    if Anchor then
                                        task.defer(PlacementController.Place, Anchor, Block)
                                    end
                                end

                                LastPosition = Position
                            end
                        end
                    end

                    if Grounded and (not Entity.Alive or Grounded ~= Entity.Humanoid or TowerMode.Value ~= "Block up"
                        or not (Services.UserInputService:IsKeyDown(Enum.KeyCode.Space) or NexusAutoBlockEnvironment.__NexusAutoBlockUpActive == true)
                        or not GetBlock()) then
                        Grounded:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                        Grounded = nil
                    end

                    task.wait(0.03)
                until not Scaffold.Enabled
            end

            HideVisual()
            if Grounded then
                Grounded:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                Grounded = nil
            end
        end,
        Tooltip = "Helps you make bridges/scaffold walk."
    })

    Expand = Scaffold:CreateSlider({
        Name = "Expand",
        Min = 1,
        Max = 6,
        Default = 1
    })
    Tower = Scaffold:CreateToggle({
        Name = "Tower",
        Default = true,
        Function = function(Callback: boolean)
            if TowerMode and TowerMode.Object then
                TowerMode.Object.Visible = Callback
            end
        end,
        Tooltip = "Goes up while you hold jump"
    })
    TowerMode = Scaffold:CreateDropdown({
        Name = "Tower mode",
        List = {"Jump", "Block up"},
        Default = "Jump",
        Darker = true,
        Visible = Tower.Enabled,
        Tooltip = "Jump - Pushes you up and scaffolds under you\nBlock up - Places blocks into you so they lift you, without jumping, and keeps you centered while standing still"
    })
    Downwards = Scaffold:CreateToggle({
        Name = "Downwards",
        Default = true
    })
    Diagonal = Scaffold:CreateToggle({
        Name = "Diagonal",
        Default = true
    })
    LimitItem = Scaffold:CreateToggle({Name = "Limit to items"})
    Mouse = Scaffold:CreateToggle({Name = "Require mouse down"})
    Scaffold:CreateToggle({
        Name = "Visual",
        Function = function(Callback: boolean)
            for _, v: any in {FillColor, OutlineColor} do
                if v and v.Object then
                    v.Object.Visible = Callback
                end
            end

            if Callback then
                task.defer(function()
                    if Visual or not FillColor or not OutlineColor then
                        return
                    end

                    local Block: Part = Instance.new("Part")
                    Block.Size = Vector3.new(3, 3, 3)
                    Block.Anchored = true
                    Block.CanCollide = false
                    Block.CanQuery = false
                    Block.CanTouch = false
                    Block.CastShadow = false
                    Block.Transparency = 1
                    Cat:Clean(Block)

                    local Selection: SelectionBox = Instance.new("SelectionBox")
                    Selection.Adornee = Block
                    Selection.LineThickness = 0.04
                    Selection.Color3 = Color3.fromHSV(OutlineColor.Hue, OutlineColor.Sat, OutlineColor.Value)
                    Selection.Transparency = 1 - OutlineColor.Opacity
                    Selection.SurfaceColor3 = Color3.fromHSV(FillColor.Hue, FillColor.Sat, FillColor.Value)
                    Selection.SurfaceTransparency = 1 - FillColor.Opacity
                    Selection.Parent = Block

                    Data.Controllers.GameQueryUtil:setQueryIgnored(Block, true)
                    Visual = Block
                end)
            else
                HideVisual()
                if Visual then
                    Visual:Destroy()
                    Visual = nil
                end
            end
        end,
        Tooltip = "Renders an overlay on the block about to be placed"
    })
    FillColor = Scaffold:CreateColorSlider({
        Name = "Fill Color",
        DefaultSat = 0,
        DefaultOpacity = 0.4,
        Darker = true,
        Visible = false,
        Function = function(Hue: number, Sat: number, Value: number, Opacity: number)
            if Visual then
                Visual.SelectionBox.SurfaceColor3 = Color3.fromHSV(Hue, Sat, Value)
                Visual.SelectionBox.SurfaceTransparency = 1 - Opacity
            end
        end
    })
    OutlineColor = Scaffold:CreateColorSlider({
        Name = "Outline Color",
        DefaultValue = 0,
        Darker = true,
        Visible = false,
        Function = function(Hue: number, Sat: number, Value: number, Opacity: number)
            if Visual then
                Visual.SelectionBox.Color3 = Color3.fromHSV(Hue, Sat, Value)
                Visual.SelectionBox.Transparency = 1 - Opacity
            end
        end
    })
    HudPosition = Scaffold:CreateTextBox({
        Name = "HUD Position",
        Default = "0,60",
        Visible = false,
        Function = function()
            if Hud then
                local X: string?, Y: string? = HudPosition.Value:match("^(%-?%d+),(%-?%d+)$")
                Hud.Position = UDim2.new(0.5, tonumber(X) or 0, 0.5, tonumber(Y) or 60)
            end
        end
    })
    Scaffold:CreateToggle({
        Name = "Block Count",
        Function = function(Callback: boolean)
            if Callback then
                if not Hud then
                    BuildHud()
                    HudConnection = Cat.Ui.Click:GetPropertyChangedSignal("Visible"):Connect(ShowHud)
                end

                ShowHud()
            elseif Hud then
                if HudConnection and HudConnection.Connected then
                    HudConnection:Disconnect()
                end

                HudConnection = nil
                Hud:Destroy()
                Hud = nil
                table.clear(HudParts)
            end
        end,
        Tooltip = "Open the menu and drag the HUD to move it"
    })

    Cat:Clean(function()
        if HudConnection and HudConnection.Connected then
            HudConnection:Disconnect()
        end
        if Hud then
            Hud:Destroy()
        end
    end)
end)()

BundledModules.SetEmote = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services

    local Entity = BundledModules.Entity

    local SetEmote
    local Emote

    local Track: AnimationTrack?
    local Gui: BillboardGui?

    local List: {string} = {}
    local EmoteTypes: {[string]: any} = {}

    for EmoteType: any, v: any in Data.Instances.EmoteMeta do
        if EmoteType ~= Data.Instances.EmoteType.NONE and v.name and not EmoteTypes[v.name] then
            EmoteTypes[v.name] = EmoteType
            table.insert(List, v.name)
        end
    end

    table.sort(List)

    local function CancelEmote(): ()
        if Track then
            Track:Stop()
            Track:Destroy()
            Track = nil
        end

        if Gui then
            Gui:Destroy()
            Gui = nil
        end

        if Entity.Alive and Entity.Character:GetAttribute("PlayingEmote") then
            Entity.Character:SetAttribute("PlayingEmote", nil)
        end
    end

    SetEmote = Cat.Categories.Utility:CreateModule({
        Name = "SetEmote",
        Function = function(Callback: boolean)
            if Callback then
                SetEmote:Toggle()

                if Entity.Alive then
                    local EmoteType: any = EmoteTypes[Emote.Value]
                    local Meta: any = Data.Instances.EmoteMeta[EmoteType]

                    if Meta then
                        CancelEmote()
                        Entity.Character:SetAttribute("PlayingEmote", EmoteType)

                        local PlayBeginSounds: any = Data.Controllers.EmoteController.createEmoteBeginAudioPlayers
                            or Data.Controllers.EmoteController.playEmoteBeginSounds
                        if PlayBeginSounds then
                            PlayBeginSounds(Data.Controllers.EmoteController, EmoteType, Services.LocalPlayer)
                        end

                        local Animation: any = Meta.animation
                        if not Animation and Meta.emoteDisplayType then
                            local Display: any = Data.Instances.EmoteDisplayMeta[Meta.emoteDisplayType]
                            Animation = Display and Display.animation
                        end

                        if Animation then
                            Track = Entity.Humanoid:LoadAnimation(Data.Controllers.GameAnimationUtil:getAnimation(Animation.type))
                            Track.Looped = Animation.looped or false
                            Track:Play(nil, nil, Animation.speed or 1)
                        end

                        if not Meta.animation then
                            local Billboard: BillboardGui = Instance.new("BillboardGui")
                            Billboard.Size = UDim2.fromScale(6, 2.5)
                            Billboard.StudsOffset = Vector3.new(0, 2, 0)
                            Billboard.AlwaysOnTop = true
                            Billboard.Adornee = Entity.Character.Head

                            local Image: ImageLabel = Instance.new("ImageLabel")
                            Image.AnchorPoint = Vector2.new(0.5, 1)
                            Image.Position = UDim2.fromScale(0.5, 1)
                            Image.Size = UDim2.fromScale(0, 0)
                            Image.Image = Meta.image
                            Image.BackgroundTransparency = 1
                            Image.ImageTransparency = 1
                            Image.ScaleType = Enum.ScaleType.Fit
                            Image.Parent = Billboard

                            Billboard.Parent = Entity.Character.Head
                            Gui = Billboard

                            Services.TweenService:Create(Image, TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {
                                Position = UDim2.fromScale(0.5, 0.5),
                                Size = UDim2.fromScale(1, 1),
                                ImageTransparency = 0
                            }):Play()
                        end

                        if Meta.allowMovement then
                            task.delay(6, CancelEmote)
                        else
                            Entity.Humanoid:GetPropertyChangedSignal("MoveDirection"):Once(CancelEmote)
                        end
                    end
                end
            end
        end,
        Tooltip = "Plays the selected emote on your character, other players can see it too"
    })

    Emote = SetEmote:CreateDropdown({
        Name = "Emote",
        List = List,
        Default = "nightmare"
    })
end)()

BundledModules.StaffDetector = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services
    local LocalPlayer: Player = Services.Players.LocalPlayer

    local Drag = BundledModules.Drag

    local StaffDetector
    local Mode, Clans, Profile, Users

    local BlacklistedClans: {string} = {"gg", "gg2", "DV", "DV2"}
    local BlacklistedUserIds: {number} = {1502104539, 3826146717, 4531785383, 1049767300, 4926350670, 653085195, 184655415, 2752307430, 5087196317, 5744061325, 1536265275}
    local Categories: {string} = {"Spectate", "Mod", "Impossible"}
    local FlagColors: {[string]: string} = {
        Spectate = "rgb(236,129,43)",
        Mod = "rgb(250,50,56)",
        Impossible = "rgb(180,90,250)"
    }
    local LeaveTooltips: {[string]: string} = {
        Spectate = "Notifies when a flagged spectator leaves",
        Mod = "Notifies when a detected staff role, blacklisted user or blacklisted clan member leaves",
        Impossible = "Notifies when a player flagged for an impossible join leaves"
    }

    local Joined: {[number]: string} = {}
    local Rejoins: {[number]: boolean} = {}
    local JoinTimes: {[number]: number} = {}
    local Watchers: {[Player]: RBXScriptConnection} = {}
    local LeaveToggles: {[string]: any} = {}
    local Entries: {StaffEntry} = {}
    local Window: TextButton?
    local InfoLabel: TextLabel?
    local Expanded: boolean = false

    local function Refresh()
        if not Window or not InfoLabel then
            return
        end

        local Counts: {[string]: number} = {Spectate = 0, Mod = 0, Impossible = 0}
        for _, v: StaffEntry in Entries do
            Counts[v.Category] += 1
        end

        local List: boolean = Expanded and #Entries > 0
        local Lines: {string} = {"<b>StaffDetector</b>", "<font size=\"4\"> </font>"}
        for _, v: string in Categories do
            table.insert(Lines, `<font color="{FlagColors[v]}">{v}: {Counts[v]}</font>`)
        end
        if List then
            table.insert(Lines, "<font size=\"4\"> </font>")
            for Index: number, v: StaffEntry in Entries do
                if Index > 8 then
                    break
                end

                table.insert(Lines, `{v.Name} <font color="{FlagColors[v.Category]}">{v.Reason}</font>`)
            end
        end

        InfoLabel.Text = table.concat(Lines, "\n")

        local Bounds: Vector2 = Cat.Ui:Measure(InfoLabel.ContentText, InfoLabel.TextSize, InfoLabel.FontFace)
        local Title: Vector2 = Cat.Ui:Measure("StaffDetector", InfoLabel.TextSize, Font.new(InfoLabel.FontFace.Family, Enum.FontWeight.Bold))
        Window.Size = UDim2.fromOffset(math.max(Bounds.X, Title.X) + 16, Bounds.Y + (List and -8 or 4))
    end

    local function Flag(Player: Player, Check: string)
        Cat:CreateNotification("StaffDetector", `Staff Detected ({Check}): {Player.Name} ({Player.UserId})`, 60, "alert")

        local Category: string = Check == "impossible_join" and "Impossible" or Check == "spectator" and "Spectate" or "Mod"
        if Player.Parent ~= nil then
            table.insert(Entries, 1, {Name = Player.Name, UserId = Player.UserId, Reason = Check, Category = Category})
        end

        Refresh()
        if Mode.Value == "Uninject" then
            task.spawn(Cat.Destroy)
            Services.StarterGui:SetCore("SendNotification", {
                Title = "StaffDetector",
                Text = `Staff Detected ({Check})\n{Player.Name} ({Player.UserId})`,
                Duration = 60
            })
        elseif Mode.Value == "Requeue" then
            Data.Controllers.QueueController:joinQueue(Data.Controllers.Store:getState().Game.queueType)
        elseif Mode.Value == "Profile" then
            Cat.Ui.Save = function() end
            if Cat.Ui.Profile ~= Profile.Value then
                Cat.Ui:Switch(Profile.Value)
            end
        elseif Mode.Value == "AutoConfig" then
            Cat.Ui.Save = function() end
            for Name: string, v: any in Cat.Modules do
                if table.find({"AutoClicker", "Reach", "Sprint", "HitFix", "StaffDetector"}, Name) or v.Category.Name == "Render" then
                    continue
                end
                if v.Enabled then
                    v:Toggle()
                end

                v.Bind:SetBind({})
            end
        end
    end

    local function CheckJoin(Player: Player, Connection: RBXScriptConnection): boolean?
        if not Player:GetAttribute("Team") and Player:GetAttribute("Spectator") and Data.Storage.MatchState == 1 and not Data.Controllers.Store:getState().Game.customMatch and tick() - (JoinTimes[Player.UserId] or 0) <= 20 then
            Connection:Disconnect()
            task.wait(5)
            if StaffDetector.Enabled and Player.Parent and not Player:GetAttribute("Team") and Player:GetAttribute("Spectator") then
                if Rejoins[Player.UserId] then
                    Cat:CreateNotification("StaffDetector", `Spectator {Player.Name} joined back after leaving`, 20, "warning")
                    if Player.Parent ~= nil then
                        table.insert(Entries, 1, {Name = Player.Name, UserId = Player.UserId, Reason = "spectator", Category = "Spectate"})
                    end

                    Refresh()
                elseif Player.FollowUserId ~= 0 and Joined[Player.FollowUserId] then
                    Cat:CreateNotification("StaffDetector", `Spectator {Player.Name} joined following {Joined[Player.FollowUserId]}`, 20, "warning")
                    if Player.Parent ~= nil then
                        table.insert(Entries, 1, {Name = Player.Name, UserId = Player.UserId, Reason = "spectator", Category = "Spectate"})
                    end

                    Refresh()
                else
                    local Success: boolean, Pages: any = pcall(Services.Players.GetFriendsAsync, Services.Players, Player.UserId)
                    if Success then
                        local Friend: string?, Finished: boolean = nil, Pages.IsFinished
                        for _ = 1, 6 do
                            for _, v: {Id: number} in Pages:GetCurrentPage() do
                                if Joined[v.Id] then
                                    Friend = Joined[v.Id]

                                    break
                                end
                            end
                            if Friend or Finished then
                                break
                            end
                            if not pcall(Pages.AdvanceToNextPageAsync, Pages) then
                                return
                            end

                            Finished = Pages.IsFinished
                        end

                        if Friend then
                            Cat:CreateNotification("StaffDetector", `Spectator {Player.Name} joined from {Friend}`, 20, "warning")
                            if Player.Parent ~= nil then
                                table.insert(Entries, 1, {Name = Player.Name, UserId = Player.UserId, Reason = "spectator", Category = "Spectate"})
                            end

                            Refresh()
                        elseif Finished then
                            Flag(Player, "impossible_join")

                            return true
                        end
                    end
                end
            end
        end

        return nil
    end

    local function Added(Player: Player)
        if Joined[Player.UserId] then
            Rejoins[Player.UserId] = true
        end

        local Teleported: number? = Player:GetAttribute("LastTeleported")
        Joined[Player.UserId] = Player.Name
        JoinTimes[Player.UserId] = Teleported and tick() - math.min(Services.Workspace:GetServerTimeNow() - Teleported, 60) or tick()
        if Player ~= LocalPlayer then
            if not table.find(BlacklistedUserIds, Player.UserId) and not table.find(Users.ListEnabled, tostring(Player.UserId)) then
                local Success: boolean, Rank: any = pcall(Player.GetRankInGroup, Player, 5774246)
                if not Success then
                    Cat:CreateNotification("StaffDetector", tostring(Rank), 30, "alert")
                end
                if (Success and Rank or 0) < 100 then
                    local Connection: RBXScriptConnection
                    Connection = Player:GetAttributeChangedSignal("Spectator"):Connect(function()
                        CheckJoin(Player, Connection)
                    end)
                    Watchers[Player] = Connection
                    StaffDetector:Clean(Connection)
                    if not CheckJoin(Player, Connection) then
                        if not Player:GetAttribute("ClanTag") then
                            Player:GetAttributeChangedSignal("ClanTag"):Wait()
                        end
                        if StaffDetector.Enabled and Clans.Enabled and table.find(BlacklistedClans, Player:GetAttribute("ClanTag")) then
                            Connection:Disconnect()
                            Flag(Player, `blacklisted_clan_{Player:GetAttribute("ClanTag"):lower()}`)
                        end
                    end
                else
                    Flag(Player, "staff_role")
                end
            else
                Flag(Player, "blacklisted_user")
            end
        end
    end

    StaffDetector = Cat.Categories.Utility:CreateModule({
        Name = "StaffDetector",
        Function = function(Callback: boolean)
            if Callback then
                StaffDetector:Clean(Services.Players.PlayerAdded:Connect(Added))
                StaffDetector:Clean(Services.Players.PlayerRemoving:Connect(function(Player: Player)
                    if Watchers[Player] then
                        Watchers[Player]:Disconnect()
                        Watchers[Player] = nil
                    end

                    for Index: number = #Entries, 1, -1 do
                        local Entry: StaffEntry = Entries[Index]
                        if Entry.UserId == Player.UserId then
                            table.remove(Entries, Index)
                            if LeaveToggles[Entry.Category].Enabled then
                                Cat:CreateNotification("StaffDetector", `{Entry.Name} left ({Entry.Reason})`, 10, "info")
                            end
                        end
                    end

                    Refresh()
                end))
                for _, v: Player in Services.Players:GetPlayers() do
                    task.spawn(Added, v)
                end
            else
                table.clear(Joined)
                table.clear(Rejoins)
                table.clear(JoinTimes)
                table.clear(Watchers)
                table.clear(Entries)
                Refresh()
            end
        end,
        Tooltip = "Detects people with a staff rank ingame"
    })

    Mode = StaffDetector:CreateDropdown({
        Name = "Mode",
        List = {"Uninject", "Profile", "Requeue", "AutoConfig", "Notify"},
        Function = function(Value: string)
            if Profile and Profile.Object then
                Profile.Object.Visible = Value == "Profile"
            end
        end
    })
    Clans = StaffDetector:CreateToggle({
        Name = "Blacklist clans",
        Default = true
    })
    Profile = StaffDetector:CreateTextBox({
        Name = "Profile",
        Default = "default",
        Darker = true,
        Visible = false
    })
    Users = StaffDetector:CreateTextList({
        Name = "Users",
        Placeholder = "player (userid)"
    })
    for _, v: string in Categories do
        LeaveToggles[v] = StaffDetector:CreateToggle({
            Name = `Notify {v} leave`,
            Tooltip = LeaveTooltips[v]
        })
    end
    StaffDetector:CreateToggle({
        Name = "Viewer",
        Function = function(Callback: boolean)
            if Callback and not Window then
                local Button: TextButton = Instance.new("TextButton")
                Button.Name = "StaffDetectorViewer"
                Button.Position = UDim2.fromOffset(12, 120)
                Button.BackgroundColor3 = Color3.new()
                Button.BackgroundTransparency = 0.5
                Button.Text = ""
                Button.AutoButtonColor = false

                local Corner: UICorner = Instance.new("UICorner")
                Corner.CornerRadius = UDim.new(0, 5)
                Corner.Parent = Button

                local Shadow: UIShadow = Instance.new("UIShadow")
                Shadow.BlurRadius = UDim.new(0, 13)
                Shadow.Transparency = 0.25
                Shadow.Parent = Button

                local Label: TextLabel = Instance.new("TextLabel")
                Label.Size = UDim2.new(1, -16, 1, -16)
                Label.Position = UDim2.fromOffset(8, 8)
                Label.BackgroundTransparency = 1
                Label.TextXAlignment = Enum.TextXAlignment.Left
                Label.TextYAlignment = Enum.TextYAlignment.Top
                Label.TextSize = 16
                Label.TextColor3 = Color3.new(1, 1, 1)
                Label.TextStrokeColor3 = Color3.new()
                Label.TextStrokeTransparency = 0.8
                Label.Font = Enum.Font.Arial
                Label.RichText = true
                Label.Parent = Button

                local Pressed: UDim2? = nil
                Button.MouseButton1Down:Connect(function()
                    Pressed = Button.Position
                end)
                Button.MouseButton1Click:Connect(function()
                    if Pressed == Button.Position then
                        Expanded = not Expanded
                        Refresh()
                    end
                end)
                Drag(Button)

                Button.Parent = Cat.Ui.Gui
                Cat:Clean(Button)
                Window, InfoLabel = Button, Label
            end

            if Window then
                Window.Visible = Callback
                Refresh()
            end
        end,
        Tooltip = "Shows a panel with detection counts, click it to list who tripped them and drag it while the GUI is open to move it"
    })

    task.delay(3, function()
        if not StaffDetector.Enabled and not StaffDetector.Removed then
            StaffDetector:Toggle(true)
        end
    end)
end)()

BundledModules.StunDisabler = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services
    local LocalPlayer: Player = Services.Players.LocalPlayer

    local Entity = BundledModules.Entity

    local StunDisabler
    local Lasso, Chance, Check
    local Effects, Dizzy, Fear, Vignettes
    local Traps, Landmines, Teleports, Portals

    local Original, Hook, OriginalVignettes, Anchored = nil, nil, nil, {}

    local function Watch(Character: Model)
        StunDisabler:Clean(Character.ChildAdded:Connect(function(Child: Instance)
            if Child:IsA("Accessory") and Child:FindFirstChild("Rope") and Random.new():NextNumber(1, 100) < Chance.Value then
                if Check.Enabled and #Entity.Targets({
                    Range = 50,
                    Players = true
                }) == 0 then
                    return
                end

                local RootPart: BasePart? = Character.PrimaryPart
                if RootPart then
                    RootPart.Anchored = true
                    Anchored[RootPart] = true

                    StunDisabler:Clean(Child.Destroying:Once(function()
                        task.wait(0.5)

                        if Anchored[RootPart] then
                            RootPart.Anchored = false
                            Anchored[RootPart] = nil
                        end
                    end))
                end
            end
        end))
    end

    StunDisabler = Cat.Categories.Utility:CreateModule({
        Name = "StunDisabler",
        Function = function(Callback: boolean)
            if Callback then
                if Lasso.Enabled then
                    if LocalPlayer.Character then
                        Watch(LocalPlayer.Character)
                    end

                    StunDisabler:Clean(LocalPlayer.CharacterAdded:Connect(function(Character: Model)
                        task.delay(1, function()
                            if StunDisabler.Enabled and LocalPlayer.Character == Character then
                                Watch(Character)
                            end
                        end)
                    end))
                end

                if Effects.Enabled then
                    if Dizzy.Enabled then
                        Services.RunService:UnbindFromRenderStep("dizzy-status")
                    end

                    if Fear.Enabled then
                        Services.RunService:UnbindFromRenderStep("werewolf-fear-status")
                    end

                    if Vignettes.Enabled then
                        OriginalVignettes = Data.Controllers.VignetteController.enableOnScreenEffects
                        Data.Controllers.VignetteController.enableOnScreenEffects = false
                        Data.Controllers.VignetteController:destroyAllVignettes()
                    end

                    StunDisabler:Clean(Data.Instances.SyncEvents.StatusEffectAdded:setPriority(1000):connect(function(Event: {entityInstance: Instance?, statusEffect: string})
                        if Event.entityInstance == LocalPlayer.Character then
                            if Dizzy.Enabled and Event.statusEffect == "dizzy" then
                                Services.RunService:UnbindFromRenderStep("dizzy-status")
                            end

                            if Fear.Enabled and Event.statusEffect == "werewolf_fear" then
                                Services.RunService:UnbindFromRenderStep("werewolf-fear-status")
                            end
                        end
                    end))
                end

                if Traps.Enabled then
                    Original = Data.Controllers.ClientScript.Get
                    Hook = function(self: any, Name: string): any
                        if StunDisabler.Enabled and Traps.Enabled and (Name == "TriggerInvisibleLandmine" and Landmines.Enabled or Name == "StepOnTeleportBlock" and Teleports.Enabled or Name == "StepOnVoidPortal" and Portals.Enabled) then
                            return {
                                SendToServer = function() end
                            }
                        end

                        return Original(self, Name)
                    end
                    Data.Controllers.ClientScript.Get = Hook
                end
            else
                if Hook and Data.Controllers.ClientScript.Get == Hook then
                    Data.Controllers.ClientScript.Get = Original
                end

                if OriginalVignettes ~= nil then
                    Data.Controllers.VignetteController.enableOnScreenEffects = OriginalVignettes
                end

                Original, Hook, OriginalVignettes = nil, nil, nil
                for i: BasePart in Anchored do
                    i.Anchored = false
                end

                table.clear(Anchored)
            end
        end,
        Tooltip = "Stops lassos, debuffs and traps from taking control of you"
    })

    Lasso = StunDisabler:CreateToggle({
        Name = "Anti lasso",
        Default = true,
        Function = function(Callback: boolean)
            for _, v: any in {Chance, Check} do
                if v and v.Object then
                    v.Object.Visible = Callback
                end
            end

            if StunDisabler.Enabled then
                StunDisabler:Toggle()
                StunDisabler:Toggle()
            end
        end,
        Tooltip = "Prevents you from getting pulled by lasso projectile."
    })
    Chance = StunDisabler:CreateSlider({
        Name = "Chance",
        Min = 0,
        Max = 100,
        Default = 100,
        Suffix = "%",
        Darker = true
    })
    Check = StunDisabler:CreateToggle({
        Name = "Only when targeting",
        Darker = true
    })
    Effects = StunDisabler:CreateToggle({
        Name = "Anti effect",
        Default = true,
        Function = function(Callback: boolean)
            for _, v: any in {Dizzy, Fear, Vignettes} do
                if v and v.Object then
                    v.Object.Visible = Callback
                end
            end

            if StunDisabler.Enabled then
                StunDisabler:Toggle()
                StunDisabler:Toggle()
            end
        end,
        Tooltip = "Throws away the parts of a debuff the game plays on your own client"
    })
    Dizzy = StunDisabler:CreateToggle({
        Name = "Dizzy",
        Default = true,
        Function = function()
            if StunDisabler.Enabled then
                StunDisabler:Toggle()
                StunDisabler:Toggle()
            end
        end,
        Darker = true,
        Tooltip = "Stops the dizzy toad swinging your walk direction around, the slow itself is on the server"
    })
    Fear = StunDisabler:CreateToggle({
        Name = "Werewolf fear",
        Default = true,
        Function = function()
            if StunDisabler.Enabled then
                StunDisabler:Toggle()
                StunDisabler:Toggle()
            end
        end,
        Darker = true,
        Tooltip = "Stops the werewolf tail walking you away from it"
    })
    Vignettes = StunDisabler:CreateToggle({
        Name = "Vignettes",
        Default = true,
        Function = function()
            if StunDisabler.Enabled then
                StunDisabler:Toggle()
                StunDisabler:Toggle()
            end
        end,
        Darker = true,
        Tooltip = "Clears the coloured screen border frozen, decay, soaked and the rest put over your view"
    })
    Traps = StunDisabler:CreateToggle({
        Name = "Trap disabler",
        Default = true,
        Function = function(Callback: boolean)
            for _, v: any in {Landmines, Teleports, Portals} do
                if v and v.Object then
                    v.Object.Visible = Callback
                end
            end

            if StunDisabler.Enabled then
                StunDisabler:Toggle()
                StunDisabler:Toggle()
            end
        end,
        Tooltip = "Drops the reports the game makes you send when you walk into a trap"
    })
    Landmines = StunDisabler:CreateToggle({
        Name = "Landmines",
        Default = true,
        Darker = true,
        Tooltip = "Stops invisible landmines from detonating on you"
    })
    Teleports = StunDisabler:CreateToggle({
        Name = "Teleport blocks",
        Darker = true,
        Tooltip = "Stops teleport blocks from moving you"
    })
    Portals = StunDisabler:CreateToggle({
        Name = "Void portals",
        Darker = true,
        Tooltip = "Stops void portals from moving you, this also blocks your own"
    })
end)()

BundledModules.AntiAFK = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services
    local LocalPlayer: Player = Services.Players.LocalPlayer

    local Disabled: {any} = {}

    Cat.Categories.World:CreateModule({
        Name = "Anti-AFK",
        Function = function(Callback: boolean)
            if Callback then
                for _, v: any in getconnections(LocalPlayer.Idled) do
                    v:Disable()
                    table.insert(Disabled, v)
                end

                for _, v: any in getconnections(Services.RunService.Heartbeat) do
                    local Success: boolean, Constants: {any} = pcall(debug.getconstants, v.Function)
                    if type(v.Function) == "function" and Success and table.find(Constants, "AfkInfo") then
                        v:Disable()
                        table.insert(Disabled, v)
                    end
                end

                Data.Controllers.ClientScript:Get("AfkInfo"):SendToServer({
                    afk = false
                })
            else
                for _, v: any in Disabled do
                    v:Enable()
                end

                table.clear(Disabled)
            end
        end,
        Tooltip = "Lets you stay ingame without getting kicked"
    })
end)()

BundledModules.AutoTool = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services
    local LocalPlayer: Player = Services.Players.LocalPlayer

    local Entity = BundledModules.Entity
    local Break = BundledModules.Break
    local SlotController = BundledModules.SlotController

    local AutoTool
    local Mode, Delay, SwitchBack

    local Looking, Previous
    local Deadline, Switching, Event = 0, false, nil

    local function Best(Block: Instance?): Tool?
        if Block and not Block:GetAttribute("NoBreak") and not Block:GetAttribute(`Team{LocalPlayer:GetAttribute("Team") or 0}NoBreak`) and not (Break.Tool and Break.Tool.Expires > tick() and not (Break.Tool.Session and Break.Tool.Session.Cancelled)) then
            local Meta: any = Data.Instances.Items[Block.Name]
            local Item: InventoryItem? = Meta and Meta.block and Data.Storage.Tools[Meta.block.breakType]
            if Item and Item.tool and Data.Storage.Hand.Tool ~= Item.tool then
                return Item.tool
            end
        end

        return nil
    end

    local function SwitchTo(Tool: Tool)
        if Switching or (SlotController.Owner ~= nil and SlotController.Owner ~= "AutoTool" and tick() < SlotController.Expires) then
            return
        end

        Switching = true
        task.spawn(function()
            if not (Break.Tool and Break.Tool.Expires > tick() and not (Break.Tool.Session and Break.Tool.Session.Cancelled)) then
                SlotController.Select(Tool)
            end

            Switching = false
        end)
    end

    AutoTool = Cat.Categories.World:CreateModule({
        Name = "AutoTool",
        Function = function(Callback: boolean)
            if Callback then
                Looking, Deadline, Previous, Switching = nil, 0, nil, false

                local Current: BindableEvent = Instance.new("BindableEvent")
                Event = Current
                AutoTool:Clean(Current)
                AutoTool:Clean(Current.Event:Connect(function()
                    Services.ContextActionService:CallFunction("block-break", Enum.UserInputState.Begin, newproxy(true))
                end))
                AutoTool:Clean(Services.RunService.Heartbeat:Connect(function()
                    if Entity.Alive and not (Break.Tool and Break.Tool.Expires > tick() and not (Break.Tool.Session and Break.Tool.Session.Cancelled)) then
                        if Mode.Value == "Look" then
                            local Held: any = Data.Storage.Hand.Tool and Data.Instances.Items[Data.Storage.Hand.Tool.Name]
                            if Held and Held.breakBlock then
                                local Camera: Camera = Services.Workspace.CurrentCamera
                                local Placer: any = Data.Storage.BlockPlacer or Data.Controllers.BlockPlacementController.blockPlacer
                                local Selector: any = Placer and Placer.clientManager and Placer.clientManager:getBlockSelector()
                                local Ray: Ray? = not Services.UserInputService.KeyboardEnabled and Camera:ScreenPointToRay(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2 - Services.GuiService:GetGuiInset().Y) or nil
                                local Info: any = Selector and Selector:getMouseInfo(1, {ray = Ray})
                                local Block: Instance? = Info and Info.target and Info.target.blockInstance or nil
                                if Block then
                                    if Block == Looking then
                                        if tick() >= Deadline then
                                            local Tool: Tool? = Best(Block)
                                            if Tool then
                                                Previous = Previous or Data.Storage.Hand.Tool
                                                SwitchTo(Tool)
                                            end
                                        end
                                    else
                                        Looking, Deadline = Block, tick() + Delay:GetRandomValue()
                                    end
                                else
                                    Looking = nil
                                    if SwitchBack.Enabled and Previous then
                                        SwitchTo(Previous)
                                        Previous = nil
                                    end
                                end
                            else
                                Looking, Previous = nil, nil
                            end
                        else
                            Looking = nil
                        end
                    end
                end))

                local Hook: (any, any, any) -> () = function(self: any, _: any, Ray: any)
                    if Mode.Value ~= "Break" then
                        return
                    end

                    local Info: any = self.clientManager:getBlockSelector():getMouseInfo(1, {ray = Ray})
                    local Tool: Tool? = Best(Info and Info.target and Info.target.blockInstance or nil)
                    if not Tool or (SlotController.Owner ~= nil and SlotController.Owner ~= "AutoTool" and tick() < SlotController.Expires) then
                        return
                    end

                    task.spawn(function()
                        if not AutoTool.Enabled or Event ~= Current or (Break.Tool and Break.Tool.Expires > tick()) then
                            return
                        end
                        if SlotController.Select(Tool) and AutoTool.Enabled and Event == Current and Services.UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                            Current:Fire()
                        end
                    end)
                end

                table.insert(Data.Storage.BreakCallbacks, Hook)
                AutoTool:Clean(function()
                    local Index: number? = table.find(Data.Storage.BreakCallbacks, Hook)
                    if Index then
                        table.remove(Data.Storage.BreakCallbacks, Index)
                    end
                end)
            else
                Looking, Previous, Event = nil, nil, nil
            end
        end,
        Tooltip = "Automatically selects the correct tool"
    })

    Mode = AutoTool:CreateDropdown({
        Name = "Mode",
        List = {"Look", "Break"},
        Default = "Break",
        Function = function(Value: string)
            for _, v: any in {Delay, SwitchBack} do
                if v and v.Object then
                    v.Object.Visible = Value == "Look"
                end
            end
        end,
        Tooltip = "Look swaps while you are still aiming at the block, Break swaps on the first hit like it used to"
    })
    Delay = AutoTool:CreateTwoSlider({
        Name = "Delay",
        Min = 0,
        Max = 1,
        DefaultMin = 0.06,
        DefaultMax = 0.16,
        Decimal = 100,
        Suffix = "seconds",
        Darker = true,
        Tooltip = "How long you have to be looking at the block before it swaps"
    })
    SwitchBack = AutoTool:CreateToggle({
        Name = "Switch back",
        Darker = true,
        Tooltip = "Puts the item you were holding back once you look away"
    })
end)()

BundledModules.BedProtector = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services
    local LocalPlayer: Player = Services.Players.LocalPlayer

    local Entity = BundledModules.Entity
    local PlacementController = BundledModules.PlacementController
    local SlotController = BundledModules.SlotController

    local BedProtector
    local Mode, Trigger, PlaceRange, Wool, Switch
    local Blacklist, Layers
    local Whitelist, Radius, NoAnimation, Limit

    local Layout: {[Vector3]: string} = {}
    local Sides: {Vector3} = {}
    for _, v: Enum.NormalId in Enum.NormalId:GetEnumItems() do
        table.insert(Sides, Vector3.FromNormalId(v) * 3)
    end

    local Old: ((...any) -> ...any)?
    local Placing: boolean = false

    local function Pyramid(Size: number): {Vector3}
        local Positions: {Vector3} = {}
        for Height: number = Size, 0, -1 do
            for Width: number = Height, 0, -1 do
                table.insert(Positions, Vector3.new(Width, Size - Height, Height + 1 - Width) * 3)
                table.insert(Positions, Vector3.new(-Width, Size - Height, Height + 1 - Width) * 3)
                table.insert(Positions, Vector3.new(Width, Size - Height, -(Height - Width)) * 3)
                table.insert(Positions, Vector3.new(-Width, Size - Height, -(Height - Width)) * 3)
            end
        end

        return Positions
    end

    local function BedNear(Range: number): BasePart?
        local LocalPosition: Vector3 = Entity.Alive and Entity.RootPart.Position or Vector3.zero
        for _, v: Instance in Services.CollectionService:GetTagged("bed") do
            if v:IsA("BasePart") and (LocalPosition - v.Position).Magnitude < Range and v:GetAttribute(`Team{LocalPlayer:GetAttribute("Team") or -1}NoBreak`) then
                return v
            end
        end

        return nil
    end

    local function Build(Bed: BasePart)
        local Blocks: {{Type: string, Health: number, Tool: Tool?, Amount: number}} = {}
        for _, v: InventoryItem in (Data.Storage.Inventory.inventory.items or {}) do
            local Block: any = Data.Instances.Items[v.itemType] and Data.Instances.Items[v.itemType].block
            if Block and (Wool.Enabled and v.itemType:find("wool") or not Wool.Enabled and not table.find(Blacklist.ListEnabled, v.itemType:find("wool") and "wool" or v.itemType)) then
                table.insert(Blocks, {Type = v.itemType, Health = Block.health or 0, Tool = v.tool, Amount = v.amount or math.huge})
            end
        end
        table.sort(Blocks, function(a: {Health: number}, b: {Health: number}): boolean
            return a.Health > b.Health
        end)

        local Delay: number = 1 / Data.Instances.CPSConstants.BLOCK_PLACE_CPS
        for Layer: number = 1, Layers.Value do
            for _, Offset: Vector3 in Pyramid(Layer) do
                if BedProtector.Enabled and Entity.Alive and #Blocks ~= 0 then
                    local Position: Vector3 = (Bed.CFrame * CFrame.new(Offset)).Position
                    if not Data.Controllers.BlockController:getStore():getBlockAt(Data.Controllers.BlockController:getBlockPosition(Position)) and (Entity.RootPart.Position - Position).Magnitude <= PlaceRange.Value then
                        local Block: {Type: string, Health: number, Tool: Tool?, Amount: number}? = nil
                        for Index: number = 0, #Blocks - 1 do
                            local Candidate: {Type: string, Health: number, Tool: Tool?, Amount: number} = Blocks[(math.min(Layer, #Blocks) + Index - 1) % #Blocks + 1]
                            if Candidate.Amount > 0 then
                                Block = Candidate

                                break
                            end
                        end
                        if Block then
                            repeat
                                task.wait()
                            until not BedProtector.Enabled or not Entity.Alive or Services.Workspace:GetServerTimeNow() - Data.Controllers.BlockCpsController.lastPlaceTimestamp >= Delay
                            if BedProtector.Enabled and Entity.Alive then
                                if Switch.Enabled and Block.Tool and (not SlotController.Owner or SlotController.Owner == "BedProtector" or tick() >= SlotController.Expires) then
                                    SlotController.Owner, SlotController.Expires = "BedProtector", tick() + 1
                                    if SlotController.Select(Block.Tool) then
                                        task.wait()
                                    end
                                end

                                task.spawn(PlacementController.Place, Position, Block.Type)
                                Block.Amount -= 1
                            end
                        end
                    end
                end
            end
        end
    end

    local function Scan(Bed: BasePart)
        table.clear(Layout)
        for _, v: Instance in Services.CollectionService:GetTagged("block") do
            if v:IsA("BasePart") and not v:HasTag("bed") and (v.Position - Bed.Position).Magnitude <= Radius.Value then
                Layout[v.Position] = v.Name
            end
        end

        local Holes: {[Vector3]: string} = {}
        for Position: Vector3, Name: string in Layout do
            for _, Offset: Vector3 in Sides do
                local Cell: Vector3 = Position + Offset
                if Layout[Cell] or Holes[Cell] or Data.Controllers.BlockController:getStore():getBlockAt(Data.Controllers.BlockController:getBlockPosition(Cell)) then
                    continue
                end

                local Walls: number = 0
                for _, Side: Vector3 in Sides do
                    if Layout[Cell + Side] then
                        Walls += 1
                    end
                end
                if Walls >= 4 then
                    Holes[Cell] = Name
                end
            end
        end

        for Position: Vector3, Name: string in Holes do
            Layout[Position] = Name
        end
    end

    local function PatchBlock(ItemType: string): (string?, Tool?)
        if Limit.Enabled then
            local Hand: Tool? = Data.Storage.Hand.Type == "block" and Data.Storage.Hand.Tool or nil
            if Hand and (not Wool.Enabled or Hand.Name:find("wool")) and table.find(Whitelist.ListEnabled, Hand.Name:find("wool") and "wool" or Hand.Name) then
                return Hand.Name, Hand
            end

            return nil, nil
        end

        local Best: InventoryItem?, Health: number? = nil, nil
        for _, v: InventoryItem in (Data.Storage.Inventory.inventory.items or {}) do
            local Block: any = Data.Instances.Items[v.itemType] and Data.Instances.Items[v.itemType].block
            if Block and (not Wool.Enabled or v.itemType:find("wool")) and table.find(Whitelist.ListEnabled, v.itemType:find("wool") and "wool" or v.itemType) then
                if v.itemType == ItemType then
                    return v.itemType, v.tool
                elseif not Health or (Block.health or 0) > Health then
                    Best, Health = v, Block.health or 0
                end
            end
        end

        return Best and Best.itemType or nil, Best and Best.tool or nil
    end

    BedProtector = Cat.Categories.World:CreateModule({
        Name = "BedProtector",
        Function = function(Callback: boolean)
            if Callback then
                local Bed: BasePart?
                if Mode.Value == "Patch" then
                    local Animation: any = Data.Controllers.BlockController:getAnimationController():getAssetId(0)
                    Old = Data.Controllers.AnimationUtil.playAnimation
                    Data.Controllers.AnimationUtil.playAnimation = function(self: any, Player: any, AssetId: any, Config: any): ...any
                        if Placing and NoAnimation.Enabled and AssetId == Animation then
                            return
                        end

                        return (Old :: (...any) -> ...any)(self, Player, AssetId, Config)
                    end

                    BedProtector:Clean(Services.CollectionService:GetInstanceAddedSignal("block"):Connect(function(Block: Instance)
                        if Bed and Block:IsA("BasePart") and not Block:HasTag("bed") and (Block.Position - Bed.Position).Magnitude <= Radius.Value then
                            Layout[Block.Position] = Block.Name
                        end
                    end))
                    BedProtector:Clean(Data.Instances.Network.BreakBlockEventZap.On(function(BlockPosition: Vector3, ...)
                        local Player: Player? = select(4, ...)
                        if typeof(Player) == "Instance" and (Player == LocalPlayer or Player:GetAttribute("Team") == LocalPlayer:GetAttribute("Team")) then
                            Layout[BlockPosition * 3] = nil
                        end
                    end))
                end

                repeat
                    if Mode.Value == "Build" then
                        local Far: number = 0
                        for _, v: Vector3 in Pyramid(Layers.Value) do
                            Far = math.max(Far, v.Magnitude)
                        end

                        local Found: BasePart? = BedNear(PlaceRange.Value + Far)
                        if Found then
                            local Previous: Tool? = Data.Storage.Hand.Tool
                            Build(Found)
                            if Switch.Enabled and Previous then
                                SlotController.Select(Previous)
                            end
                        elseif Trigger.Value == "On Key" then
                            Cat:CreateNotification("BedProtector", "Unable to locate bed", 5)
                            BedProtector:Toggle()

                            break
                        end
                    else
                        local Found: BasePart? = BedNear(PlaceRange.Value + Radius.Value)
                        if Found ~= Bed then
                            Bed = Found
                            if Bed then
                                Scan(Bed)
                            else
                                table.clear(Layout)
                            end
                        end

                        if Bed and Entity.Alive then
                            local Previous: Tool? = Data.Storage.Hand.Tool
                            local Holes: {{Position: Vector3, Name: string}} = {}
                            for Position: Vector3, Name: string in Layout do
                                if (Entity.RootPart.Position - Position).Magnitude <= PlaceRange.Value and not Data.Controllers.BlockController:getStore():getBlockAt(Data.Controllers.BlockController:getBlockPosition(Position)) then
                                    table.insert(Holes, {Position = Position, Name = Name})
                                end
                            end
                            table.sort(Holes, function(a: {Position: Vector3}, b: {Position: Vector3}): boolean
                                return (a.Position - (Bed :: BasePart).Position).Magnitude < (b.Position - (Bed :: BasePart).Position).Magnitude
                            end)

                            for _, v: {Position: Vector3, Name: string} in Holes do
                                if not Data.Controllers.BlockController:getStore():getBlockAt(Data.Controllers.BlockController:getBlockPosition(v.Position)) then
                                    local Item: string?, Tool: Tool? = PatchBlock(v.Name)
                                    if not Item then
                                        break
                                    end
                                    if Switch.Enabled and Tool and (not SlotController.Owner or SlotController.Owner == "BedProtector" or tick() >= SlotController.Expires) then
                                        SlotController.Owner, SlotController.Expires = "BedProtector", tick() + 1
                                        if SlotController.Select(Tool) then
                                            task.wait()
                                        end
                                    end

                                    Placing = true
                                    PlacementController.Place(v.Position, Item)
                                    Placing = false

                                    task.wait(1 / Data.Instances.CPSConstants.BLOCK_PLACE_CPS)
                                end
                            end

                            if Switch.Enabled and Previous then
                                SlotController.Select(Previous)
                            end
                        elseif not Bed and Trigger.Value == "On Key" then
                            Cat:CreateNotification("BedProtector", "Unable to locate bed", 5)
                            BedProtector:Toggle()

                            break
                        end
                    end

                    task.wait(0.5)
                    if Trigger.Value == "On Key" then
                        BedProtector:Toggle()

                        break
                    end
                until not BedProtector.Enabled
            else
                if Old then
                    Data.Controllers.AnimationUtil.playAnimation = Old
                    Old = nil
                end

                Placing = false
                table.clear(Layout)
            end
        end,
        Tooltip = "Builds a defense around your bed or patches holes in your bed defense"
    })

    Mode = BedProtector:CreateDropdown({
        Name = "Mode",
        List = {"Build", "Patch"},
        Default = "Build",
        Function = function(Value: string)
            for _, v: any in {Blacklist, Layers} do
                if v and v.Object then
                    v.Object.Visible = Value == "Build"
                end
            end
            for _, v: any in {Whitelist, Radius, NoAnimation, Limit} do
                if v and v.Object then
                    v.Object.Visible = Value == "Patch"
                end
            end

            if BedProtector.Enabled then
                BedProtector:Toggle()
                BedProtector:Toggle()
            end
        end,
        Tooltip = "Build places layers of your strongest blocks around the bed\nPatch puts back the blocks an enemy broke out of your defense"
    })
    Trigger = BedProtector:CreateDropdown({
        Name = "Trigger",
        List = {"Toggle", "On Key"},
        Default = "Toggle"
    })
    PlaceRange = BedProtector:CreateSlider({
        Name = "Place Range",
        Min = 1,
        Max = 60,
        Default = 15
    })
    Wool = BedProtector:CreateToggle({
        Name = "Wool only",
        Tooltip = "Only uses wools to defend the bed."
    })
    Switch = BedProtector:CreateToggle({Name = "Auto Switch"})
    Blacklist = BedProtector:CreateTextList({
        Name = "Blacklist",
        Default = {"siege_tnt", "tnt"}
    })
    Layers = BedProtector:CreateSlider({
        Name = "Layers",
        Min = 1,
        Max = 6,
        Default = 2,
        Tooltip = "How many layers go around your bed. Your strongest block goes closest to it, and your weakest one is reused when you have fewer block types than layers"
    })
    Whitelist = BedProtector:CreateTextList({
        Name = "Whitelist",
        Default = {"wool", "obsidian"},
        Visible = false
    })
    Radius = BedProtector:CreateSlider({
        Name = "Defense Radius",
        Min = 3,
        Max = 30,
        Default = 15,
        Suffix = function(Value: number)
            return Value == 1 and "stud" or "studs"
        end,
        Tooltip = "How far out from the bed still counts as your defense",
        Visible = false
    })
    NoAnimation = BedProtector:CreateToggle({
        Name = "No Animation",
        Tooltip = "Hides the arm swing every patched block would otherwise play",
        Visible = false
    })
    Limit = BedProtector:CreateToggle({
        Name = "Limit to item",
        Visible = false
    })
end)()

BundledModules.BlockIn = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services
    local LocalPlayer: Player = Services.Players.LocalPlayer

    local Entity = BundledModules.Entity
    local PlacementController = BundledModules.PlacementController
    local SlotController = BundledModules.SlotController

    local BlockIn
    local Mode, BedChecker, AutoPatch, PlacementMode, PlacementSpeed, Center, Priority, Switch, Return, Wool, Blacklist

    local CenterOrigin: Vector3?, Anchor: Vector3?, AimGoal: Vector3?, AimHome: Vector3?
    local AimReturning: boolean = false
    local LastPlace: number, LastWarning: number = 0, 0
    local Retries: {[Vector3]: number} = {}
    local Loaded: number = os.clock()
    local Params: RaycastParams = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Include

    local Scan: number, BedRange: number, TurnSpeed: number, TurnTolerance: number, RetryGap: number, FailGap: number = 30, 14, 24, 0.35, 0.3, 4
    local Directions: {Vector3} = {Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1)}
    local Sides: {Vector3} = {}
    for _, v: Enum.NormalId in Enum.NormalId:GetEnumItems() do
        table.insert(Sides, Vector3.FromNormalId(v) * 3)
    end

    local function Origin(): Vector3
        if Data.Storage.Map and Params.FilterDescendantsInstances[1] ~= Data.Storage.Map then
            Params.FilterDescendantsInstances = {Data.Storage.Map}
        end

        local Position: Vector3 = Entity.RootPart.Position
        local Hit: RaycastResult? = Services.Workspace:Raycast(Position, Vector3.new(0, -Scan, 0), Params)
        local Raw: Vector3 = Hit and Vector3.new(Position.X, Hit.Position.Y + 1.5, Position.Z) or Position

        return Vector3.new(math.round(Raw.X / 3) * 3, math.round(Raw.Y / 3) * 3, math.round(Raw.Z / 3) * 3)
    end

    local function BedNear(Partial: boolean?): BasePart?
        for _, v: Instance in Services.CollectionService:GetTagged("bed") do
            if not v:IsA("BasePart") or (Entity.RootPart.Position - v.Position).Magnitude >= BedRange or v:GetAttribute(`Team{LocalPlayer:GetAttribute("Team") or -1}NoBreak`) then
                continue
            end

            local Handler: any = Data.Controllers.BlockController:getHandlerRegistry():getHandler(v.Name)
            local Cells: {Vector3} = Handler and Handler:getContainedPositions(v) or {v.Position / 3}
            local Inside: {[Vector3]: boolean} = {}
            for _, Cell: Vector3 in Cells do
                Inside[Cell * 3] = true
            end

            local Covered: number, Open: number = 0, 0
            for _, Cell: Vector3 in Cells do
                for _, Side: Vector3 in Sides do
                    local Position: Vector3 = Cell * 3 + Side
                    if Inside[Position] then
                        continue
                    end

                    if not Data.Controllers.BlockController:getStore():getBlockAt(Data.Controllers.BlockController:getBlockPosition(Position)) then
                        Open += 1
                    elseif Side.Y >= 0 then
                        Covered += 1
                    end
                end
            end

            if Partial and Covered > 0 or (not Partial and Open == 0) then
                return v
            end
        end

        return nil
    end

    local function Blocks(): {{Type: string, Health: number, Tool: Tool?, Amount: number}}
        local List: {{Type: string, Health: number, Tool: Tool?, Amount: number}} = {}
        for _, v: InventoryItem in (Data.Storage.Inventory.inventory.items or {}) do
            local Block: any = Data.Instances.Items[v.itemType] and Data.Instances.Items[v.itemType].block
            if not Block or not (Wool.Enabled and v.itemType:find("wool") or not Wool.Enabled and not table.find(Blacklist.ListEnabled, v.itemType:find("wool") and "wool" or v.itemType)) then
                continue
            end

            local Hotbar: boolean = false
            for _, Entry: any in (Data.Storage.Inventory.hotbar or {}) do
                if Entry.item and Entry.item.tool == v.tool then
                    Hotbar = true
                end
            end
            if Hotbar or not Switch.Enabled then
                table.insert(List, {Type = v.itemType, Health = Block.health or 0, Tool = v.tool, Amount = v.amount or math.huge})
            end
        end
        table.sort(List, function(a: {Health: number}, b: {Health: number}): boolean
            if Priority.Value == "Hardest" then
                return a.Health > b.Health
            end

            return a.Health < b.Health
        end)

        return List
    end

    local function Enclosure(Base: Vector3, Grounded: boolean): {Vector3}
        local Enemy: Target? = Entity.Targets({Range = 60, Players = true})[1]
        local Facing: Vector3 = Enemy and Enemy.RootPart.Position - Base or Vector3.zero
        local Order: {Vector3} = table.clone(Directions)
        table.sort(Order, function(a: Vector3, b: Vector3): boolean
            return a:Dot(Facing) > b:Dot(Facing)
        end)

        local Cells: {Vector3} = {}
        if Grounded and not Services.Workspace:Raycast(Base, Vector3.new(0, -3, 0), Params) then
            table.insert(Cells, Vector3.new(0, -3, 0))
        end
        for _, Height: number in {0, 3} do
            for _, v: Vector3 in Order do
                table.insert(Cells, Vector3.new(v.X * 3, Height, v.Z * 3))
            end
        end
        if Grounded then
            table.insert(Cells, Vector3.new(Order[1].X * 3, 6, Order[1].Z * 3))
            table.insert(Cells, Vector3.new(0, 6, 0))
        end

        return Cells
    end

    local function StopAim()
        if AimGoal and Entity.Alive then
            if AimHome then
                Entity.RootPart.CFrame = CFrame.lookAlong(Entity.RootPart.Position, AimHome)
            end

            Entity.Humanoid.AutoRotate = true
        end

        AimGoal, AimHome, AimReturning = nil, nil, false
    end

    local function PlacePattern(Base: Vector3, Cells: {Vector3}, List: {{Type: string, Health: number, Tool: Tool?, Amount: number}}, Limit: number, Patching: boolean?)
        local Placed: number = 0
        local Previous: Tool? = Data.Storage.Hand.Tool

        for _, Offset: Vector3 in Cells do
            if Placed >= Limit or not BlockIn.Enabled or not Entity.Alive then
                break
            end

            local Position: Vector3 = Base + Offset
            if not Data.Controllers.BlockController:getStore():getBlockAt(Data.Controllers.BlockController:getBlockPosition(Position)) then
                repeat
                    local Empty: boolean = List[1] ~= nil and List[1].Amount <= 0
                    if Empty then
                        table.remove(List, 1)
                    end
                until not Empty

                local Block: {Type: string, Health: number, Tool: Tool?, Amount: number}? = List[1]
                if not Block then
                    break
                end
                if PlacementMode.Value == "Blatant" and Center.Enabled then
                    CenterOrigin = Base
                end

                local Turning: boolean = Patching == true and PlacementMode.Value == "Legit" and Offset.Y >= 0 and Offset.Y <= 3 and (Offset.X ~= 0 or Offset.Z ~= 0)
                if Turning then
                    if not AimHome then
                        local Look: Vector3 = Entity.RootPart.CFrame.LookVector * Vector3.new(1, 0, 1)
                        AimHome = Look.Magnitude > 0.001 and Look.Unit or nil
                    end

                    AimGoal, AimReturning = Vector3.new(Offset.X, 0, Offset.Z), false
                end

                local CPS: number = Data.Instances.CPSConstants.BLOCK_PLACE_CPS
                local Delay: number = 1 / math.max(PlacementMode.Value == "Legit" and math.min(CPS, PlacementSpeed.Value) or CPS, 1)
                local Deadline: number = os.clock() + 0.3
                repeat
                    task.wait()

                    local Look: Vector3 = Entity.Alive and Entity.RootPart.CFrame.LookVector * Vector3.new(1, 0, 1) or Vector3.zero
                    local Aimed: boolean = not AimGoal or Look.Magnitude < 0.001 or math.acos(math.clamp(Look.Unit:Dot(AimGoal.Unit), -1, 1)) < TurnTolerance
                until not BlockIn.Enabled or not Entity.Alive or (Services.Workspace:GetServerTimeNow() - math.max(LastPlace, Data.Controllers.BlockCpsController.lastPlaceTimestamp) >= Delay and (not Turning or Aimed or os.clock() > Deadline))
                if not BlockIn.Enabled or not Entity.Alive then
                    break
                end

                local Offset2D: Vector3 = (Entity.RootPart.Position - Base) * Vector3.new(1, 0, 1)
                if PlacementMode.Value == "Legit" and math.max(math.abs(Offset2D.X), math.abs(Offset2D.Z)) > 1.5 then
                    break
                end
                if Switch.Enabled and Block.Tool and (not SlotController.Owner or SlotController.Owner == "Block-In" or tick() >= SlotController.Expires) then
                    SlotController.Owner, SlotController.Expires = "Block-In", tick() + 1
                    SlotController.Select(Block.Tool)
                end

                LastPlace = Services.Workspace:GetServerTimeNow()
                task.spawn(PlacementController.Place, Position, Block.Type)

                local Registered: boolean = Data.Controllers.BlockController:getStore():getBlockAt(Data.Controllers.BlockController:getBlockPosition(Position)) ~= nil
                if Registered then
                    Block.Amount -= 1
                    Placed += 1
                end
                if Patching then
                    Retries[Position] = os.clock() + (Registered and RetryGap or FailGap)
                end
            end
        end

        if Patching then
            if AimHome then
                AimGoal, AimReturning = AimHome, true
            else
                StopAim()
            end
        end

        if Return.Enabled and Switch.Enabled and Previous then
            SlotController.Select(Previous)
        end
    end

    local function Build(): boolean
        if not Entity.Alive or (Mode.Value ~= "On bind" and not BedNear()) then
            return false
        end

        local List: {{Type: string, Health: number, Tool: Tool?, Amount: number}} = Blocks()
        local Early: boolean = false
        repeat
            task.wait()
            if Entity.Alive and not Early then
                local Base: Vector3 = Origin()
                local Drop: number = Entity.RootPart.Position.Y - Base.Y
                Early = Drop >= 6 and Drop <= 24
                if Early then
                    PlacePattern(Base, Enclosure(Base, false), List, PlacementMode.Value == "Blatant" and Center.Enabled and math.huge or 3)
                end
            end
        until not BlockIn.Enabled or not Entity.Alive or Entity.Humanoid.FloorMaterial ~= Enum.Material.Air

        if Entity.Alive then
            local Base: Vector3 = Origin()
            PlacePattern(Base, Enclosure(Base, true), List, math.huge)
            Anchor = Base
        end

        CenterOrigin = nil

        return true
    end

    local function Patch()
        if Entity.Alive then
            local Base: Vector3? = Anchor
            local Casting: any = LocalPlayer:GetAttribute("IsCasting")
            if Base and Entity.Humanoid.FloorMaterial ~= Enum.Material.Air and not Data.Controllers.BlockPlacementController.disabled and (not Casting or Casting == 0 or Casting == "") then
                local Offset: Vector3 = (Entity.RootPart.Position - Base) * Vector3.new(1, 0, 1)
                if math.max(math.abs(Offset.X), math.abs(Offset.Z)) <= 1.5 then
                    local Current: Vector3 = Origin()
                    if Current.Y <= Base.Y then
                        if Current.Y < Base.Y then
                            Base, Anchor = Current, Current
                            table.clear(Retries)
                        end

                        local Cells: {Vector3} = {}
                        for _, v: Vector3 in Enclosure(Base :: Vector3, true) do
                            local Position: Vector3 = (Base :: Vector3) + v
                            if not Data.Controllers.BlockController:getStore():getBlockAt(Data.Controllers.BlockController:getBlockPosition(Position)) and (Retries[Position] or 0) <= os.clock() then
                                table.insert(Cells, v)
                            end
                        end
                        if #Cells > 0 then
                            local List: {{Type: string, Health: number, Tool: Tool?, Amount: number}} = Blocks()
                            if #List > 0 then
                                PlacePattern(Base :: Vector3, Cells, List, math.huge, true)
                                CenterOrigin = nil
                            elseif os.clock() - LastWarning > 5 then
                                LastWarning = os.clock()
                                Cat:CreateNotification("Block-In", "No blocks left to patch with", 3, "warning")
                            end
                        end
                    end
                end
            end
        else
            Anchor = nil
        end
    end

    BlockIn = Cat.Categories.World:CreateModule({
        Name = "Block-In",
        Function = function(Callback: boolean)
            if Callback then
                if os.clock() - Loaded < 3 and Mode.Value == "On bind" and AutoPatch.Enabled then
                    task.defer(BlockIn.Toggle, BlockIn, false)
                elseif BedChecker.Enabled and not (Entity.Alive and BedNear(true)) then
                    Cat:CreateNotification("Block-In", "You are not near an enemy bed defense", 3, "warning")
                    task.defer(BlockIn.Toggle, BlockIn, false)
                else
                    LastPlace, Anchor = 0, nil
                    table.clear(Retries)
                    BlockIn:Clean(Services.RunService.PreSimulation:Connect(function()
                        if not CenterOrigin or PlacementMode.Value ~= "Blatant" or not Center.Enabled or not Entity.Alive or not isnetworkowner(Entity.RootPart) then
                            return
                        end

                        Entity.RootPart.CFrame = CFrame.new(CenterOrigin.X, Entity.RootPart.Position.Y, CenterOrigin.Z) * Entity.RootPart.CFrame.Rotation
                        Entity.RootPart.AssemblyLinearVelocity = Vector3.new(0, Entity.RootPart.AssemblyLinearVelocity.Y, 0)
                    end))
                    BlockIn:Clean(Services.RunService.PostSimulation:Connect(function(Delta: number)
                        if AimGoal then
                            if Entity.Alive then
                                local Look: Vector3 = Entity.RootPart.CFrame.LookVector * Vector3.new(1, 0, 1)
                                Entity.Humanoid.AutoRotate = false
                                if AimReturning and (Look.Magnitude < 0.001 or math.acos(math.clamp(Look.Unit:Dot(AimGoal.Unit), -1, 1)) < 0.02) then
                                    StopAim()
                                else
                                    Entity.RootPart.CFrame = Entity.RootPart.CFrame:Lerp(CFrame.lookAlong(Entity.RootPart.Position, AimGoal), math.clamp((TurnSpeed + 2) * Delta, 0, 1))
                                end
                            else
                                AimGoal, AimHome, AimReturning = nil, nil, false
                            end
                        end
                    end))
                    BlockIn:Clean(function()
                        CenterOrigin, Anchor = nil, nil
                        StopAim()
                    end)

                    local Guarding: boolean = false
                    repeat
                        local Bind: boolean = Mode.Value == "On bind"
                        if BedChecker.Enabled and not (Entity.Alive and BedNear(true)) then
                            Cat:CreateNotification("Block-In", "You are not near an enemy bed defense", 3, "warning")
                            BlockIn:Toggle(false)

                            break
                        end

                        if Guarding and Bind and AutoPatch.Enabled then
                            Patch()
                            task.wait(0.1)
                        elseif Guarding and Bind then
                            BlockIn:Toggle(false)

                            break
                        else
                            local Built: boolean = Build()
                            Guarding = Bind and Built and AutoPatch.Enabled
                            if Bind and not Guarding then
                                BlockIn:Toggle(false)

                                break
                            end
                            if not Bind then
                                task.wait(0.5)
                            end
                        end
                    until not BlockIn.Enabled
                end
            end
        end,
        Tooltip = "Automatically blocks you in by building walls around you"
    })

    Mode = BlockIn:CreateDropdown({
        Name = "Mode",
        List = {"On bind", "When near"},
        Default = "On bind",
        Function = function(Value: string)
            if AutoPatch and AutoPatch.Object then
                AutoPatch.Object.Visible = Value == "On bind"
            end
        end,
        Tooltip = "On bind blocks you in once per keypress, When near keeps you blocked in while you are on an enemy bed"
    })
    BedChecker = BlockIn:CreateToggle({
        Name = "Bed checker",
        Tooltip = `Won't turn on, and turns itself off with a warning, whenever you are not within {BedRange} studs of an enemy bed that has blocks around it`
    })
    AutoPatch = BlockIn:CreateToggle({
        Name = "Auto Patch",
        Tooltip = "On bind only. Stays on after blocking you in and refills any wall block that gets broken, or rebuilds around you when you drop to a lower level, until you turn the module off yourself. In Legit mode your character silently turns toward each side block it patches and back afterwards"
    })
    PlacementMode = BlockIn:CreateDropdown({
        Name = "Placement mode",
        List = {"Legit", "Blatant"},
        Default = "Legit",
        Function = function(Value: string)
            if PlacementSpeed and PlacementSpeed.Object then
                PlacementSpeed.Object.Visible = Value == "Legit"
            end
            if Center and Center.Object then
                Center.Object.Visible = Value == "Blatant"
            end
        end,
        Tooltip = "Legit uses your placement speed and lets you move freely, Blatant builds at the normal limit with optional centering"
    })
    PlacementSpeed = BlockIn:CreateSlider({
        Name = "Placement speed",
        Min = 1,
        Max = math.max(Data.Instances.CPSConstants.BLOCK_PLACE_CPS, 1),
        Default = math.max(Data.Instances.CPSConstants.BLOCK_PLACE_CPS, 1),
        Suffix = "blocks/s",
        Tooltip = "Blocks placed per second in Legit mode"
    })
    Center = BlockIn:CreateToggle({
        Name = "Center",
        Default = true,
        Visible = false,
        Tooltip = "Holds you in the middle of your block while it builds, so no side gets skipped"
    })
    Priority = BlockIn:CreateDropdown({
        Name = "Block priority",
        List = {"Lowest cost", "Hardest"},
        Default = "Lowest cost"
    })
    Switch = BlockIn:CreateToggle({
        Name = "Switch",
        Default = true
    })
    Return = BlockIn:CreateToggle({
        Name = "Return to last slot",
        Default = true
    })
    Wool = BlockIn:CreateToggle({Name = "Wool only"})
    Blacklist = BlockIn:CreateTextList({
        Name = "Blacklist",
        Default = {"cannon", "siege_tnt", "tnt"}
    })
end)()

BundledModules.ChestSteal = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services

    local Entity = BundledModules.Entity

    local ChestSteal
    local Range, Visualize, FillColor, OutlineColor, Animate, Speed, Open, Legit, Skywars

    local Session: number = 0
    local Delays: {[Instance]: number} = {}
    local Box: Part?
    local BoxTween: Tween?
    local BoxTarget: BasePart?

    local function UpdateBox(Chest: BasePart?)
        if Box then
            if Chest ~= BoxTarget then
                if BoxTween then
                    BoxTween:Cancel()
                    BoxTween = nil
                end

                if not Chest then
                    Box.Parent = nil
                elseif Animate.Enabled and Box.Parent == Services.Workspace.CurrentCamera then
                    BoxTween = Services.TweenService:Create(Box, TweenInfo.new(Speed.Value, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = Chest.CFrame})
                    BoxTween:Play()
                else
                    Box.CFrame = Chest.CFrame
                    Box.Parent = Services.Workspace.CurrentCamera
                end

                BoxTarget = Chest
            end
            if Chest then
                local Selection: SelectionBox = Box:FindFirstChildOfClass("SelectionBox") :: SelectionBox
                Selection.Color3 = Color3.fromHSV(OutlineColor.Hue, OutlineColor.Sat, OutlineColor.Value)
                Selection.Transparency = 1 - OutlineColor.Opacity
                Selection.SurfaceColor3 = Color3.fromHSV(FillColor.Hue, FillColor.Sat, FillColor.Value)
                Selection.SurfaceTransparency = 1 - FillColor.Opacity
            end
        end
    end

    local function Loot(Value: Instance?)
        local Chest: Instance? = Value and (Value :: ObjectValue).Value or nil
        local Items: {Instance} = Chest and Chest:GetChildren() or {}
        if not Chest or #Items <= 1 or (Delays[Chest] or 0) >= tick() then
            return
        end

        Delays[Chest] = tick() + 0.2

        local Observed: ObjectValue? = Entity.Character and Entity.Character:FindFirstChild("ObservedChestFolder") :: ObjectValue?
        local Previous: Instance? = Observed and Observed.Value or nil
        Data.Controllers.ClientScript:GetNamespace("Inventory"):Get("SetObservedChest"):SendToServer(Chest)
        for _, v: Instance in Items do
            if not v:IsA("Accessory") then
                continue
            end

            task.spawn(pcall, function()
                Data.Controllers.ClientScript:GetNamespace("Inventory"):Get("ChestGetItem"):CallServer(Chest, v)
            end)
            if Legit.Enabled then
                task.wait(0.2)
            end
        end

        Data.Controllers.ClientScript:GetNamespace("Inventory"):Get("SetObservedChest"):SendToServer(Previous)
    end

    ChestSteal = Cat.Categories.World:CreateModule({
        Name = "ChestSteal",
        Function = function(Callback: boolean)
            if Callback then
                Session += 1

                local Current: number = Session
                repeat
                    task.wait()
                until Data.Controllers.Store:getState().Game.queueType ~= "bedwars_test" or Session ~= Current or not ChestSteal.Enabled
                if Session ~= Current or not ChestSteal.Enabled or (Skywars.Enabled and not Data.Controllers.Store:getState().Game.queueType:find("skywars")) then
                    return
                end

                repeat
                    local Target: BasePart? = nil
                    if Entity.Alive and Data.Storage.MatchState ~= 2 then
                        if Open.Enabled then
                            if Data.Controllers.AppController:isAppOpen("ChestApp") then
                                local Observed: ObjectValue? = Entity.Character:FindFirstChild("ObservedChestFolder") :: ObjectValue?
                                Loot(Observed)
                                for _, v: Instance in Services.CollectionService:GetTagged("chest") do
                                    local Folder: ObjectValue? = v:FindFirstChild("ChestFolderValue") :: ObjectValue?
                                    if Observed and Observed.Value and Folder and Folder.Value == Observed.Value then
                                        Target = v :: BasePart
                                    end
                                end
                            end
                        else
                            local Closest: number = math.huge
                            for _, v: Instance in Services.CollectionService:GetTagged("chest") do
                                local Distance: number = (Entity.RootPart.Position - (v :: BasePart).Position).Magnitude
                                if Distance > Range.Value then
                                    continue
                                end

                                Loot(v:FindFirstChild("ChestFolderValue"))
                                if Distance < Closest then
                                    Closest, Target = Distance, v :: BasePart
                                end
                            end
                        end
                    end

                    UpdateBox(Target)

                    task.wait(0.1)
                until not ChestSteal.Enabled or Session ~= Current
            else
                UpdateBox(nil)
                table.clear(Delays)
            end
        end,
        Tooltip = "Grabs items from near chests."
    })

    Range = ChestSteal:CreateSlider({
        Name = "Range",
        Min = 0,
        Max = 18,
        Default = 18,
        Suffix = function(Value: number)
            return Value == 1 and "stud" or "studs"
        end
    })
    Visualize = ChestSteal:CreateToggle({
        Name = "Visualize",
        Function = function(Callback: boolean)
            for _, v: any in {FillColor, OutlineColor, Animate, Speed} do
                if v and v.Object then
                    v.Object.Visible = Callback
                end
            end

            if Callback then
                local Part: Part = Instance.new("Part")
                Part.Size = Vector3.new(3, 3, 3)
                Part.Anchored = true
                Part.CanCollide = false
                Part.CanQuery = false
                Part.CanTouch = false
                Part.CastShadow = false
                Part.Transparency = 1
                Cat:Clean(Part)

                local Selection: SelectionBox = Instance.new("SelectionBox")
                Selection.Adornee = Part
                Selection.LineThickness = 0.04
                Selection.Parent = Part

                Data.Controllers.GameQueryUtil:setQueryIgnored(Part, true)
                Box = Part
            else
                UpdateBox(nil)
                if Box then
                    Box:Destroy()
