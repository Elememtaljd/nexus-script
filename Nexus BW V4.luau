BundledModules.CropESP = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services

    local LabelPool = BundledModules.LabelPool

    local CropESP
    local Color, Transparency, Scale

    local Tags: {[Instance]: TextLabel} = {}
    local Labels: LabelPool = LabelPool()

    local function Added(Crop: Instance)
        if Tags[Crop] then
            return
        end

        local Label: TextLabel = Labels.Acquire()
        Label.Text = Data.Instances.Items[Crop.Name] and Data.Instances.Items[Crop.Name].displayName or "Crop"
        Label.TextSize = 14 * Scale.Value
        Label.TextColor3 = Color3.fromHSV(Color.Hue, Color.Sat, Color.Value)
        Label.BackgroundTransparency = Transparency.Value

        local Bounds: Vector2 = Cat.Ui:Measure(Label.ContentText, Label.TextSize, Label.FontFace)
        Label.Size = UDim2.fromOffset(Bounds.X + 8, Bounds.Y + 7)
        Tags[Crop] = Label
    end

    CropESP = Cat.Categories.Render:CreateModule({
        Name = "CropESP",
        Function = function(Callback: boolean)
            if Callback then
                for _, v: Instance in Services.CollectionService:GetTagged("HarvestableCrop") do
                    Added(v)
                end

                CropESP:Clean(Services.CollectionService:GetInstanceAddedSignal("HarvestableCrop"):Connect(Added))
                CropESP:Clean(Services.CollectionService:GetInstanceRemovedSignal("HarvestableCrop"):Connect(function(Crop: Instance)
                    local Label: TextLabel? = Tags[Crop]
                    if not Label then
                        return
                    end

                    Tags[Crop] = nil
                    Label.Visible = false
                    table.insert(Labels.Free, Label)
                end))

                CropESP:Clean(Services.RunService.PreRender:Connect(function()
                    local Camera: Camera = Services.Workspace.CurrentCamera
                    for Crop: Instance, Label: TextLabel in Tags do
                        if Crop.Parent then
                            local Position: Vector3 = Crop:IsA("Model") and Crop:GetPivot().Position or (Crop :: BasePart).Position
                            local Screen: Vector3, Visible: boolean = Camera:WorldToViewportPoint(Position + Vector3.new(0, 1, 0))

                            if Label.Visible ~= Visible then
                                Label.Visible = Visible
                            end

                            if Visible then
                                Label.Position = UDim2.fromOffset(Screen.X, Screen.Y)
                            end
                        else
                            Tags[Crop] = nil
                            Label.Visible = false

                            table.insert(Labels.Free, Label)
                        end
                    end
                end))
            else
                table.clear(Tags)
                table.clear(Labels.Free)
                Labels.Folder:ClearAllChildren()
            end
        end,
        Tooltip = "Renders crops that are ready to harvest"
    })

    Color = CropESP:CreateColorSlider({
        Name = "Text Color",
        Function = function(Hue: number, Sat: number, Value: number)
            for _, v: TextLabel in Tags do
                v.TextColor3 = Color3.fromHSV(Hue, Sat, Value)
            end
        end
    })
    Transparency = CropESP:CreateSlider({
        Name = "Transparency",
        Min = 0,
        Max = 1,
        Default = 0.5,
        Decimal = 100,
        Function = function(Value: number)
            for _, v: TextLabel in Tags do
                v.BackgroundTransparency = Value
            end
        end
    })
    Scale = CropESP:CreateSlider({
        Name = "Scale",
        Min = 0.1,
        Max = 1.5,
        Default = 1,
        Decimal = 10,
        Function = function(Value: number)
            for _, v: TextLabel in Tags do
                v.TextSize = 14 * Value

                local Bounds: Vector2 = Cat.Ui:Measure(v.ContentText, v.TextSize, v.FontFace)
                v.Size = UDim2.fromOffset(Bounds.X + 8, Bounds.Y + 7)
            end
        end
    })
end)()

BundledModules.ESP = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services

    local Entity = BundledModules.Entity
    local Boxes = BundledModules.Boxes

    local Camera: Camera = Services.Workspace.CurrentCamera

    local ESP
    local Targets, BoundingBox, BoxColor, BoxStyle, Name, NameColor, HealthBar, HealthText, Distance, HeldItem, Armor, Enchant, Rank, DistanceCheck, MaxDistance, TeamCheck, Self

    local Slots: {[any]: Box} = {}
    local Loadouts: {[any]: {Expires: number, Images: {string}}} = {}
    local Enchants: {[string]: string} = {}
    local Ranks: {[Player]: string} = {}
    for _, v: any in Data.Instances.EnchantMeta do
        Enchants[`StatusEffect_{(string.gsub(v.statusEffect, "_%d+$", ""))}`] = v.image
    end

    local Sight: RaycastParams = RaycastParams.new()
    Sight.FilterType = Enum.RaycastFilterType.Exclude
    Sight.RespectCanCollide = true

    local function Loadout(Player: Player): {string}
        local Images: {string} = {}
        local Success: boolean, Inventory: any = pcall(Data.Controllers.InventoryUtil.getInventory, Player)
        if Success and HeldItem.Enabled and Inventory.hand and Data.Instances.Items[Inventory.hand.itemType] then
            table.insert(Images, Data.Instances.Items[Inventory.hand.itemType].image)
        end

        if Success and Armor.Enabled then
            local Worn: {[number]: string} = {}
            for _, v: any in Inventory.armor or {} do
                local Meta: any = type(v) == "table" and Data.Instances.Items[v.itemType]
                if Meta and Meta.armor then
                    Worn[Meta.armor.slot] = Meta.image
                end
            end

            for Slot: number = 0, 2 do
                if Worn[Slot] then
                    table.insert(Images, Worn[Slot])
                end
            end
        end

        if Enchant.Enabled and Player.Character then
            for Attribute: string in Player.Character:GetAttributes() do
                local Image: string? = Enchants[(string.gsub(Attribute, "_%d+$", ""))]
                if Image then
                    table.insert(Images, Image)

                    break
                end
            end
        end

        if Rank.Enabled and not Ranks[Player] then
            Ranks[Player] = ""
            task.spawn(function()
                local Fetched: boolean, Result: any = pcall(function(): any
                    return Data.Controllers.ClientScript:Get("FetchRanks"):CallServer({Player.UserId})
                end)
                local Division: number? = Fetched and type(Result) == "table" and Result[1] and Result[1].rankDivision or nil
                Ranks[Player] = Division and Data.Instances.RankMeta[Division] and Data.Instances.RankMeta[Division].image or ""
            end)
        end

        if Rank.Enabled and Ranks[Player] ~= "" then
            table.insert(Images, Ranks[Player])
        end

        return Images
    end

    ESP = Cat.Categories.Render:CreateModule({
        Name = "ESP",
        Function = function(Callback: boolean)
            if Callback then
                ESP:Clean(Services.RunService.RenderStepped:Connect(function()
                    local Lines: Color3 = Color3.fromHSV(BoxColor.Hue, BoxColor.Sat, BoxColor.Value)
                    local Label: Color3 = Color3.fromHSV(NameColor.Hue, NameColor.Sat, NameColor.Value)
                    if Targets.Walls.Enabled then
                        local Ignore: {Instance} = {Camera}
                        for _, v: any in Entity.Entities do
                            if v.Character then
                                table.insert(Ignore, v.Character)
                            end
                        end

                        Sight.FilterDescendantsInstances = Ignore
                    end

                    local Seen: {[any]: boolean} = {}
                    for _, v: any in Entity.Entities do
                        Seen[v] = true

                        if (not v.Self or Self.Enabled) and (not v.NPC or Targets.NPCs.Enabled) and (v.NPC or Targets.Players.Enabled) and (not TeamCheck.Enabled or v.Self or v.NPC or v.TargetCheck()) then
                            if v.NPC or v.Player.Parent then
                                Slots[v] = Slots[v] or Boxes.Make()

                                local Slot: Box = Slots[v]
                                local Character: Model? = v.Character
                                local Humanoid: Humanoid? = v.Humanoid
                                local Root: BasePart? = v.RootPart
                                if v.Alive and Character and Humanoid and Root and Humanoid.Health > 0 then
                                    local UUID: string = tostring(Character:GetAttribute("EntityUUID"))
                                    local Shell: Model? = v.NPC and Data.Controllers.StatefulEntityUtil.uuidToClientEntity[UUID]
                                    local Smooth: BasePart? = Shell and Shell:FindFirstChild("RootPart") :: BasePart?
                                    local Center: Vector3 = Smooth and Smooth.Position or Root.Position
                                    local Studs: number = (Camera.CFrame.Position - Center).Magnitude
                                    if (not DistanceCheck.Enabled or Studs <= MaxDistance.Value) and (not Targets.Invisible.Enabled or not Entity.Invisible(v)) and (not Targets.Walls.Enabled or not Services.Workspace:Raycast(Camera.CFrame.Position, Center - Camera.CFrame.Position, Sight)) then
                                        local Head: BasePart? = Character:FindFirstChild("Head") :: BasePart?
                                        local Up: number = Root.Size.Y / 2 + (Head and Head.Size.Y or 0) + 0.8
                                        local Legs: number = Head and Humanoid.RigType == Enum.HumanoidRigType.R6 and 2 or Humanoid.HipHeight
                                        local Down: number = Root.Size.Y / 2 + Legs + 0.8
                                        local Axis: Vector3 = Camera.CFrame.UpVector
                                        local Top: Vector3 = Camera:WorldToViewportPoint(Center + Axis * Up)
                                        local Bottom: Vector3 = Camera:WorldToViewportPoint(Center - Axis * Down)
                                        if Top.Z > 0 and Bottom.Z > 0 then
                                            local Half: number = (Bottom.Y - Top.Y) * 0.34
                                            local X0: number, Y0: number = math.floor(Top.X - Half), math.floor(Top.Y)
                                            local X1: number, Y1: number = math.floor(Top.X + Half), math.floor(Bottom.Y)

                                            local Used: number = BoundingBox.Enabled and Boxes.Shape(Slot, BoxStyle.Value, X0, Y0, X1, Y1) or 0
                                            for Index: number, Line: DrawingLine in Slot.Lines do
                                                Line.Visible = Index <= Used
                                                Line.Color = Lines
                                                Slot.Outlines[Index].Visible = Index <= Used
                                            end
                                            Slot.Used = Used

                                            local Ratio: number = math.clamp(Humanoid.Health / math.max(Humanoid.MaxHealth, 1), 0, 1)
                                            Slot.Back.Visible = HealthBar.Enabled
                                            Slot.Fill.Visible = HealthBar.Enabled

                                            if HealthBar.Enabled then
                                                Slot.Back.Position = Vector2.new(X0 - 6, Y0 - 1)
                                                Slot.Back.Size = Vector2.new(4, Y1 - Y0 + 2)
                                                Slot.Fill.Position = Vector2.new(X0 - 5, Y1 - (Y1 - Y0) * Ratio)
                                                Slot.Fill.Size = Vector2.new(2, (Y1 - Y0) * Ratio)
                                                Slot.Fill.Color = (Color3.fromRGB(235, 77, 75)):Lerp(Color3.fromRGB(138, 192, 147), Ratio)
                                            end

                                            Slot.Name.Visible = Name.Enabled
                                            if Name.Enabled then
                                                Slot.Name.Text = if v.NPC then v.Name else v.Player.DisplayName
                                                Slot.Name.Color = Label
                                                Slot.Name.Position = Vector2.new((X0 + X1) / 2, Y0 - 4)
                                            end

                                            Slot.Vitals.Visible = HealthText.Enabled
                                            if HealthText.Enabled then
                                                Slot.Vitals.Text = `{math.floor(Humanoid.Health)} hp`
                                                Slot.Vitals.Color = (Color3.fromRGB(235, 77, 75)):Lerp(Color3.fromRGB(138, 192, 147), Ratio)
                                                Slot.Vitals.Position = Vector2.new((X0 + X1) / 2, Y1 + 2)
                                            end

                                            Slot.Distance.Visible = Distance.Enabled
                                            if Distance.Enabled then
                                                Slot.Distance.Text = `{math.floor(Studs)} {math.floor(Studs) == 1 and "stud" or "studs"}`
                                                Slot.Distance.Position = Vector2.new((X0 + X1) / 2, Y1 + (HealthText.Enabled and 24 or 2))
                                            end

                                            if v.Player and (HeldItem.Enabled or Armor.Enabled or Enchant.Enabled or Rank.Enabled) and (not Loadouts[v] or Loadouts[v].Expires < tick()) then
                                                Loadouts[v] = {Expires = tick() + 0.5, Images = Loadout(v.Player)}
                                            end

                                            local Images: {string} = Loadouts[v] and Loadouts[v].Images or {}
                                            local Width: number = (#Images - 1) * 22 + 24
                                            for Index: number, Icon: ImageLabel in Slot.Icons do
                                                Icon.Visible = Images[Index] ~= nil
                                                if Images[Index] then
                                                    if Icon.Image ~= Images[Index] then
                                                        Icon.Image = Images[Index]
                                                    end

                                                    Icon.Position = UDim2.fromOffset(math.floor((X0 + X1) / 2 - Width / 2) + (Index - 1) * 22, Name.Enabled and Y0 - 27 or Y0 - 2)
                                                end
                                            end
                                        else
                                            Boxes.Hide(Slot)
                                        end
                                    else
                                        Boxes.Hide(Slot)
                                    end
                                else
                                    Boxes.Hide(Slot)
                                end
                            else
                                if Slots[v] then
                                    Boxes.Destroy(Slots[v])
                                    Slots[v] = nil
                                end
                            end
                        else
                            if Slots[v] then
                                Boxes.Hide(Slots[v])
                            end
                        end
                    end

                    for k: any, v: Box in Slots do
                        if not Seen[k] then
                            Boxes.Destroy(v)
                            Slots[k] = nil
                            Loadouts[k] = nil
                        end
                    end
                end))
            else
                for _, v: Box in Slots do
                    Boxes.Hide(v)
                end

                table.clear(Loadouts)
            end
        end,
        Tooltip = "Draws a box, name, health and distance over players and NPCs"
    })

    Targets = ESP:CreateTargets({
        Players = true,
        NoPriority = true
    })
    BoundingBox = ESP:CreateToggle({
        Name = "Bounding box",
        Default = true,
        Function = function(Callback: boolean)
            if BoxStyle and BoxStyle.Object then
                BoxStyle.Object.Visible = Callback
            end
        end
    })
    BoxStyle = ESP:CreateDropdown({
        Name = "Box style",
        List = {"Corners", "Full", "Rounded"},
        Default = "Corners",
        Darker = true,
        Visible = BoundingBox.Enabled
    })
    BoxColor = ESP:CreateColorSlider({
        Name = "Box color",
        DefaultSat = 0
    })
    Name = ESP:CreateToggle({
        Name = "Name",
        Default = true
    })
    NameColor = ESP:CreateColorSlider({
        Name = "Name color",
        DefaultSat = 0
    })
    HealthBar = ESP:CreateToggle({
        Name = "Health bar",
        Default = true
    })
    HealthText = ESP:CreateToggle({Name = "Health text"})
    Distance = ESP:CreateToggle({
        Name = "Distance",
        Default = true
    })
    HeldItem = ESP:CreateToggle({
        Name = "Held item",
        Function = function()
            table.clear(Loadouts)
        end,
        Tooltip = "Shows the item they are holding above their name"
    })
    Armor = ESP:CreateToggle({
        Name = "Armor",
        Function = function()
            table.clear(Loadouts)
        end,
        Tooltip = "Shows the helmet, chestplate and boots they are wearing"
    })
    Enchant = ESP:CreateToggle({
        Name = "Enchant",
        Function = function()
            table.clear(Loadouts)
        end,
        Tooltip = "Shows the icon of the enchant they have active"
    })
    Rank = ESP:CreateToggle({
        Name = "Rank",
        Function = function()
            table.clear(Loadouts)
        end,
        Tooltip = "Shows their ranked division icon, fetched once per player"
    })
    DistanceCheck = ESP:CreateToggle({
        Name = "Distance check",
        Function = function(Callback: boolean)
            if MaxDistance and MaxDistance.Object then
                MaxDistance.Object.Visible = Callback
            end
        end
    })
    MaxDistance = ESP:CreateSlider({
        Name = "Max distance",
        Min = 10,
        Max = 1000,
        Default = 250,
        Darker = true,
        Visible = DistanceCheck.Enabled,
        Suffix = function(Value: number): string
            return Value == 1 and "stud" or "studs"
        end
    })
    TeamCheck = ESP:CreateToggle({
        Name = "Team check",
        Tooltip = "Hides your teammates"
    })
    Self = ESP:CreateToggle({Name = "Show self"})

    Cat:Clean(function()
        for _, v: Box in Slots do
            Boxes.Destroy(v)
        end
        table.clear(Slots)
    end)
end)()

-- NexusV4 native NameTags port.
-- Settings and behavior adapted from the user-supplied CV Src(4).luau.
-- Designed for insertion into the bundled BedWars source after Data initialization.
BundledModules.NameTags = (function()
    local Cat = BundledModules.UI.Cat
    local Services = BundledModules.Services
    local Entity = BundledModules.Entity
    local Players = Services.Players
    local LocalPlayer = Services.LocalPlayer
    local TextService = Services.TextService or game:GetService("TextService")
    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

    local NameTags
    local Targets, FontOption, Color, Scale, Background, Health, Distance
    local Equipment, Inventory, InventoryList, Enchant, Rank, DisplayName
    local Priority, DrawingToggle, DistanceCheck, DistanceLimit

    local Active = {}
    local RankIcons = {}
    local RankFetching = {}
    local EnchantIcons = {}
    local epoch = 0
    for _, meta in pairs(Data.Instances.EnchantMeta or {}) do
        if type(meta) == "table" and type(meta.statusEffect) == "string" then
            EnchantIcons[(meta.statusEffect:gsub("_%d+$", ""))] = meta.image
        end
    end

    local function chosenColor()
        return Color3.fromHSV((Color and Color.Hue) or 0, (Color and Color.Sat) or 0, (Color and Color.Value) or 1)
    end

    local function fontChoice()
        local wanted = FontOption and FontOption.Value
        if typeof(wanted) == "EnumItem" then return wanted end
        if type(wanted) == "string" then
            local ok, found = pcall(function() return Enum.Font[wanted] end)
            if ok and found then return found end
        end
        return Enum.Font.Gotham
    end

    local function escapeRich(value)
        return tostring(value or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    end

    local function clean(entry)
        if not entry then return end
        if entry.Gui then pcall(function() entry.Gui:Destroy() end) end
        if entry.Draw then
            for _, object in pairs(entry.Draw) do
                pcall(function() object.Visible = false; object:Remove() end)
            end
        end
    end

    local function clearAll()
        for key, entry in pairs(Active) do
            clean(entry)
            Active[key] = nil
        end
    end

    local function drawingAvailable()
        return DrawingToggle.Enabled and type(Drawing) == "table" and type(Drawing.new) == "function"
    end

    local function create(entity, draw)
        local item = {Drawing = draw, Icons = {}, InventoryIcons = {}, RefreshAt = 0, CachedInventory = nil}
        if draw then
            local bg = Drawing.new("Square")
            bg.Filled = true
            bg.Thickness = 0
            bg.Color = Color3.new(0, 0, 0)
            bg.ZIndex = 1
            bg.Visible = false
            local text = Drawing.new("Text")
            text.Center = true
            text.Outline = true
            text.Font = 0
            text.ZIndex = 2
            text.Visible = false
            item.Draw = {BG = bg, Text = text}
        else
            local gui = Instance.new("BillboardGui")
            gui.Name = "NexusNameTags"
            gui.Size = UDim2.fromOffset(165, 28)
            gui.AlwaysOnTop = true
            gui.LightInfluence = 0
            gui.MaxDistance = 2000
            gui.ResetOnSpawn = false
            gui.StudsOffsetWorldSpace = Vector3.new(0, 1.85, 0)
            gui.Parent = PlayerGui
            local label = Instance.new("TextLabel")
            label.Name = "Name"
            label.Size = UDim2.new(1, 0, 0, 23)
            label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            label.BorderSizePixel = 0
            label.TextStrokeTransparency = 0.65
            label.TextSize = 14
            label.RichText = true
            label.TextXAlignment = Enum.TextXAlignment.Center
            label.Parent = gui
            Instance.new("UICorner", label).CornerRadius = UDim.new(0, 4)
            local equipment = Instance.new("Frame")
            equipment.Name = "Equipment"
            equipment.BackgroundTransparency = 1
            equipment.Size = UDim2.fromOffset(165, 23)
            equipment.Parent = gui
            local items = Instance.new("Frame")
            items.Name = "Inventory"
            items.BackgroundTransparency = 1
            items.Size = UDim2.fromOffset(165, 24)
            items.Parent = gui
            item.Gui, item.Label, item.EquipmentHolder, item.InventoryHolder = gui, label, equipment, items
        end
        Active[entity] = item
        return item
    end

    local function setIcons(holder, existing, images, size, y, width)
        for i, object in pairs(existing) do
            if i > #images then object.Visible = false end
        end
        local count = #images
        for i = 1, count do
            local imageInfo = images[i]
            local url = type(imageInfo) == "table" and imageInfo.Image or imageInfo
            local amount = type(imageInfo) == "table" and imageInfo.Amount or nil
            local icon = existing[i]
            if not icon then
                icon = Instance.new("ImageLabel")
                icon.BackgroundTransparency = 1
                icon.ScaleType = Enum.ScaleType.Fit
                icon.Size = UDim2.fromOffset(size, size)
                icon.Parent = holder
                local counter = Instance.new("TextLabel")
                counter.Name = "Amount"
                counter.BackgroundTransparency = 1
                counter.Size = UDim2.new(1, 0, 0, 12)
                counter.Position = UDim2.new(0, 0, 1, -12)
                counter.Font = Enum.Font.GothamBold
                counter.TextSize = 10
                counter.TextXAlignment = Enum.TextXAlignment.Right
                counter.TextColor3 = Color3.new(1, 1, 1)
                counter.TextStrokeTransparency = 0
                counter.Parent = icon
                existing[i] = icon
            end
            icon.Image = type(url) == "string" and url or ""
            icon.Amount.Text = amount and amount > 1 and tostring(amount) or ""
            icon.Position = UDim2.fromOffset(math.floor((width - count * (size + 2) + 2) / 2) + (i - 1) * (size + 2), y)
            icon.Visible = icon.Image ~= ""
        end
    end

    local function getInventory(player)
        if not player then return nil end
        local ok, result = pcall(function()
            return Data.Controllers.InventoryUtil.getInventory(player)
        end)
        return ok and type(result) == "table" and result or nil
    end

    local function metaIcon(item)
        if type(item) ~= "table" then return nil end
        local meta = Data.Instances.Items[item.itemType or ""]
        return meta and meta.image or nil
    end

    local function collectEquipment(player, inv)
        local images = {}
        if inv then
            local hand = metaIcon(inv.hand)
            if hand then table.insert(images, hand) end
            local armor = {}
            for _, value in pairs(inv.armor or {}) do
                local meta = type(value) == "table" and Data.Instances.Items[value.itemType] or nil
                if meta and meta.armor and meta.image then armor[meta.armor.slot] = meta.image end
            end
            for slot = 0, 2 do
                if armor[slot] then table.insert(images, armor[slot]) end
            end
        end
        if player then
            local kit = tostring(player:GetAttribute("PlayingAsKits") or "none"):split(",")[1]
            local meta = Data.Instances.BedwarsKitMeta and Data.Instances.BedwarsKitMeta[kit]
            if meta and meta.renderImage then table.insert(images, meta.renderImage) end
        end
        return images
    end

    local function collectInventory(inv)
        local images = {}
        if not inv then return images end
        local whitelist = InventoryList and InventoryList.ListEnabled or {}
        for _, value in pairs(inv.items or {}) do
            if #images >= 12 then break end
            if type(value) == "table" and (#whitelist == 0 or table.find(whitelist, value.itemType)) then
                local url = metaIcon(value)
                if url then table.insert(images, {Image = url, Amount = value.amount or 1}) end
            end
        end
        return images
    end

    local function requestRank(player)
        if not player or RankIcons[player] ~= nil or RankFetching[player] then return end
        RankFetching[player] = true
        task.spawn(function()
            local icon = ""
            local ok, result = pcall(function()
                return Data.Controllers.ClientScript:Get("FetchRanks"):CallServer({player.UserId})
            end)
            if ok and type(result) == "table" and type(result[1]) == "table" then
                local division = result[1].rankDivision
                local meta = division and Data.Instances.RankMeta[division]
                if meta and type(meta.image) == "string" then icon = meta.image end
            end
            RankIcons[player] = icon
            RankFetching[player] = nil
        end)
    end

    local function enchantIcon(character)
        if not character then return nil end
        for name in pairs(character:GetAttributes()) do
            local image = EnchantIcons[(name:gsub("_%d+$", ""))]
            if image then return image end
        end
        return nil
    end

    local function isAllowed(v, localRoot)
        if not v or v.Self or not v.Alive or not v.RootPart or not v.Character or not v.Character.Parent then return false end
        if not v.NPC and (not v.Player or not v.Player.Parent or not Targets.Players.Enabled) then return false end
        if v.NPC and not Targets.NPCs.Enabled then return false end
        if v.Humanoid and v.Humanoid.Health <= 0 then return false end
        if Priority.Enabled and type(v.TargetCheck) == "function" then
            local ok, targetable = pcall(v.TargetCheck)
            if ok and not targetable then return false end
        end
        if DistanceCheck.Enabled then
            local d = localRoot and (localRoot.Position - v.RootPart.Position).Magnitude or math.huge
            if d < DistanceLimit.ValueMin or d > DistanceLimit.ValueMax then return false end
        end
        return true
    end

    local function renderOne(v, entry, camera, localRoot)
        local root = v.RootPart
        local head = v.Character:FindFirstChild("Head") or root
        local ownDistance = localRoot and math.floor((root.Position - localRoot.Position).Magnitude) or 0
        local text = escapeRich((v.Player and (DisplayName.Enabled and v.Player.DisplayName or v.Player.Name)) or v.Name or v.Character.Name)
        if Distance.Enabled then
            text = '<font color="#68ee8a">[' .. tostring(ownDistance) .. ']</font> ' .. text
        end
        if Health.Enabled then
            local current = v.Humanoid and v.Humanoid.Health or v.Health or 0
            local maximum = v.Humanoid and v.Humanoid.MaxHealth or v.MaxHealth or 100
            local ratio = math.clamp(current / math.max(maximum, 1), 0, 1)
            local color = Color3.fromHSV(ratio * 0.35, 0.85, 0.94)
            local hex = string.format("#%02x%02x%02x", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
            text ..= ' <font color="' .. hex .. '">' .. tostring(math.floor(current + 0.5)) .. '</font>'
        end
        local shade = chosenColor()
        local opacity = math.clamp(Background.Value, 0, 1)
        local scaling = math.clamp(Scale.Value, 0.1, 1.5)
        if entry.Drawing then
            local screen, onscreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 2.1, 0))
            local draw = entry.Draw
            draw.Text.Visible = onscreen and screen.Z > 0
            draw.BG.Visible = draw.Text.Visible
            if draw.Text.Visible then
                draw.Text.Text = text:gsub("<[^>]->", "")
                draw.Text.Color = shade
                draw.Text.Size = math.floor(15 * scaling)
                draw.Text.Position = Vector2.new(screen.X, screen.Y - 18)
                draw.BG.Color = Color3.new(0, 0, 0)
                draw.BG.Transparency = 1 - opacity
                local bounds = draw.Text.TextBounds
                draw.BG.Position = Vector2.new(screen.X - (bounds.X + 10) / 2, screen.Y - bounds.Y - 23)
                draw.BG.Size = Vector2.new(bounds.X + 10, bounds.Y + 9)
            end
            return
        end
        entry.Gui.Adornee = head
        entry.Label.Font = fontChoice()
        entry.Label.TextSize = math.floor(14 * scaling)
        entry.Label.TextColor3 = shade
        entry.Label.BackgroundTransparency = opacity
        entry.Label.Text = text
        local plain = text:gsub("<[^>]->", "")
        local bounds = TextService:GetTextSize(plain, entry.Label.TextSize, entry.Label.Font, Vector2.new(1200, 100))
        local width = math.clamp(math.floor(bounds.X + 22), 85, 370)
        local rowHeight = math.floor(24 * scaling)
        local showEquipment = Equipment.Enabled or Enchant.Enabled or Rank.Enabled
        local showInventory = Inventory.Enabled
        local total = rowHeight + (showEquipment and 26 or 0) + (showInventory and 25 or 0)
        entry.Gui.Size = UDim2.fromOffset(width, total)
        entry.Label.Size = UDim2.new(1, 0, 0, rowHeight)
        entry.EquipmentHolder.Visible = showEquipment
        entry.InventoryHolder.Visible = showInventory
        entry.EquipmentHolder.Position = UDim2.fromOffset(0, rowHeight)
        entry.InventoryHolder.Position = UDim2.fromOffset(0, rowHeight + (showEquipment and 26 or 0))
        if (showEquipment or showInventory) and (entry.RefreshAt or 0) < os.clock() then
            entry.RefreshAt = os.clock() + 0.75
            entry.CachedInventory = getInventory(v.Player)
        end
        if showEquipment then
            local images = Equipment.Enabled and collectEquipment(v.Player, entry.CachedInventory) or {}
            if Enchant.Enabled then
                local image = enchantIcon(v.Character)
                if image then table.insert(images, image) end
            end
            if Rank.Enabled and v.Player then
                requestRank(v.Player)
                if RankIcons[v.Player] and RankIcons[v.Player] ~= "" then table.insert(images, RankIcons[v.Player]) end
            end
            setIcons(entry.EquipmentHolder, entry.Icons, images, 23, 0, width)
        end
        if showInventory then
            setIcons(entry.InventoryHolder, entry.InventoryIcons, collectInventory(entry.CachedInventory), 22, 0, width)
        end
    end

    NameTags = Cat.Categories.Render:CreateModule({
        Name = "NameTags",
        Tooltip = "Renders customizable player and NPC nametags through walls (from the original CV NameTags module).",
        Function = function(enabled)
            epoch += 1
            local myEpoch = epoch
            clearAll()
            if not enabled then return end
            task.spawn(function()
                while NameTags.Enabled and epoch == myEpoch and not Cat.Dead do
                    local camera = Services.Workspace.CurrentCamera
                    local localRoot = Entity.RootPart
                    local draw = drawingAvailable()
                    local seen = {}
                    if camera then
                        for _, v in pairs(Entity.Entities) do
                            if isAllowed(v, localRoot) then
                                seen[v] = true
                                local entry = Active[v]
                                if entry and entry.Drawing ~= draw then
                                    clean(entry)
                                    Active[v] = nil
                                    entry = nil
                                end
                                if not entry then
                                    local ok, result = pcall(create, v, draw)
                                    if ok then entry = result end
                                end
                                if entry then
                                    local ok, err = pcall(renderOne, v, entry, camera, localRoot)
                                    if not ok then
                                        -- An inventory or avatar entry may be temporarily missing while loading.
                                        clean(entry)
                                        Active[v] = nil
                                    end
                                end
                            end
                        end
                    end
                    for v, entry in pairs(Active) do
                        if not seen[v] then clean(entry); Active[v] = nil end
                    end
                    task.wait(0.12)
                end
                if epoch == myEpoch then clearAll() end
            end)
        end
    })

    Targets = NameTags:CreateTargets({Players = true})
    FontOption = NameTags:CreateFont({Name = "Font", Default = "Gotham"})
    Color = NameTags:CreateColorSlider({Name = "Player Color"})
    Scale = NameTags:CreateSlider({Name = "Scale", Default = 1, Min = 0.1, Max = 1.5, Decimal = 10})
    Background = NameTags:CreateSlider({Name = "Transparency", Default = 0.5, Min = 0, Max = 1, Decimal = 10})
    Health = NameTags:CreateToggle({Name = "Health"})
    Distance = NameTags:CreateToggle({Name = "Distance"})
    Equipment = NameTags:CreateToggle({Name = "Equipment"})
    Inventory = NameTags:CreateToggle({Name = "Inventory", Tooltip = "Shows the selected carried items and quantities",
        Function = function(enabled)
            if InventoryList and InventoryList.Object then InventoryList.Object.Visible = enabled end
        end})
    InventoryList = NameTags:CreateTextList({Name = "Inventory Items", Default = {"fireball", "glue_projectile", "telepearl", "tnt"}, Darker = true, Visible = false,
        Tooltip = "Item types to count; an empty list displays everything", Function = function()
            for _, entry in pairs(Active) do entry.RefreshAt = 0 end
        end})
    Enchant = NameTags:CreateToggle({Name = "Show Enchant"})
    Rank = NameTags:CreateToggle({Name = "Show Rank"})
    DisplayName = NameTags:CreateToggle({Name = "Use Displayname", Default = true})
    Priority = NameTags:CreateToggle({Name = "Priority Only", Default = true})
    DrawingToggle = NameTags:CreateToggle({Name = "Drawing", Tooltip = "Use executor Drawing objects for text-only tags (if available)"})
    DistanceCheck = NameTags:CreateToggle({Name = "Distance Check", Function = function(enabled)
        if DistanceLimit and DistanceLimit.Object then DistanceLimit.Object.Visible = enabled end
    end})
    DistanceLimit = NameTags:CreateTwoSlider({Name = "Player Distance", Min = 0, Max = 256, DefaultMin = 0, DefaultMax = 64,
        Darker = true, Visible = DistanceCheck.Enabled})

    Cat:Clean(function()
        epoch += 1
        clearAll()
        table.clear(RankIcons)
        table.clear(RankFetching)
    end)
    return NameTags
end)()

BundledModules.ItemESP = (function()
    local Cat = BundledModules.UI.Cat
    local Font: Font = BundledModules.UI.Font

    local Services = BundledModules.Services

    local Entity = BundledModules.Entity
    local Boxes = BundledModules.Boxes

    local ItemESP
    local Distance, Shadow, Scale, Whitelist, TextColor, Icons, Traps, Mine, TrapList, Pots, Hives, BoxToggle, BoxStyle, BoxColor

    local Tags: {[Instance]: any} = {}

    local Names: {[string]: string} = {
        glue_trap = "Gloop",
        grave_trap = "Grave",
        grave_trap_block = "Grave",
        invisible_landmine = "Landmine",
        lucky_block_trap = "Lucky Trap",
        snap_trap = "Snap Trap",
        spike_trap = "Spikes",
        tesla_trap = "Tesla"
    }

    local function Style(Tag: any)
        local Color: Color3 = Color3.fromHSV(TextColor.Hue, TextColor.Sat, TextColor.Value)
        for Index: number, v: any in {Tag.Slot.Name, Tag.Slot.Distance, Tag.Slot.Vitals} do
            v.BackgroundTransparency = 1
            v.AnchorPoint = Vector2.new(Index == 1 and 0.5 or Index == 2 and 1 or 0, 0.5)
            v.Scale = Scale.Value
            v.Shadow = Shadow.Enabled
        end

        Tag.Slot.Name.Color = Color
        Tag.Slot.Vitals.Color = Color
        Tag.Pic = nil
    end

    local function Add(Item: Instance, Kind: string, Name: string)
        local Meta: any = Data.Instances.Items[Item.Name]
        local Tag: any = {Slot = Boxes.Make(), Image = Meta and Meta.image, Name = Name, Kind = Kind}
        if Tag.Image then
            Tag.Slot.Icons[1].Image = Tag.Image
        end

        Style(Tag)
        Tags[Item] = Tag
    end

    local function Added(Item: Instance)
        if Tags[Item] or not Item:IsA("BasePart") then
            return
        end

        local Name: string = Data.Instances.Items[Item.Name] and Data.Instances.Items[Item.Name].displayName or Item.Name
        if #Whitelist.ListEnabled > 0 then
            local Allowed: boolean = false
            for _, v: string in Whitelist.ListEnabled do
                if v:lower() == Item.Name:lower() or v:lower() == Name:lower() then
                    Allowed = true

                    break
                end
            end
            if not Allowed then
                return
            end
        end

        Add(Item, "Item", Name)
    end

    local function Placed(Block: Instance)
        if Tags[Block] or not Block:IsA("BasePart") then
            return
        end

        if Pots.Enabled and Block.Name == "desert_pot" then
            Add(Block, "Pot", "Pot")
        elseif Traps.Enabled and Names[Block.Name] and table.find(TrapList.ListEnabled, Names[Block.Name]) then
            Add(Block, "Trap", Names[Block.Name])
        end
    end

    local function Hive(Block: Instance)
        if Tags[Block] or not Block:IsA("BasePart") then
            return
        end

        local Owner: Player? = Services.Players:GetPlayerByUserId(Block:GetAttribute("PlacedByUserId") or 0)
        Add(Block, "Hive", Owner and `{Owner.DisplayName}'s hive` or "Beehive")
    end

    local function IsMine(Block: Instance): boolean
        local UserId: number? = Block:GetAttribute("PlacedByUserId")
        if not UserId or UserId == 0 then
            return false
        end

        if UserId == Services.LocalPlayer.UserId then
            return true
        end

        local Placer: Player? = Services.Players:GetPlayerByUserId(UserId)

        return Placer ~= nil and Placer:GetAttribute("Team") == Services.LocalPlayer:GetAttribute("Team")
    end

    local function Bounds(Part: BasePart, Camera: Camera): {number}?
        local MinX: number, MinY: number = math.huge, math.huge
        local MaxX: number, MaxY: number = -math.huge, -math.huge
        for _, v: Vector3 in Boxes.Edges do
            local Point: Vector3 = Camera:WorldToViewportPoint(Part.CFrame:PointToWorldSpace(v * Part.Size / 2))
            if Point.Z <= 0 then
                return nil
            end

            MinX, MaxX = math.min(MinX, Point.X), math.max(MaxX, Point.X)
            MinY, MaxY = math.min(MinY, Point.Y), math.max(MaxY, Point.Y)
        end

        return {math.floor(MinX) - 3, math.floor(MinY) - 3, math.ceil(MaxX) + 3, math.ceil(MaxY) + 3}
    end

    local function Draw(Slot: Box, Color: Color3, Area: {number}?)
        local Used: number = Area and Boxes.Shape(Slot, BoxStyle.Value, Area[1], Area[2], Area[3], Area[4]) or 0
        for Index: number, Line: DrawingLine in Slot.Lines do
            Line.Visible = Index <= Used
            Line.Color = Color
            Slot.Outlines[Index].Visible = Index <= Used
        end

        Slot.Used = Used
    end

    local function Restart()
        if ItemESP and ItemESP.Enabled then
            ItemESP:Toggle()
            ItemESP:Toggle()
        end
    end

    ItemESP = Cat.Categories.Render:CreateModule({
        Name = "ItemESP",
        Function = function(Callback: boolean)
            if Callback then
                for _, v: Instance in Services.CollectionService:GetTagged("ItemDrop") do
                    Added(v)
                end

                ItemESP:Clean(Services.CollectionService:GetInstanceAddedSignal("ItemDrop"):Connect(Added))

                if Traps.Enabled or Pots.Enabled then
                    for _, v: Instance in Services.CollectionService:GetTagged("block") do
                        Placed(v)
                    end

                    ItemESP:Clean(Services.CollectionService:GetInstanceAddedSignal("block"):Connect(Placed))
                end

                if Hives.Enabled then
                    for _, v: Instance in Services.CollectionService:GetTagged("beehive") do
                        Hive(v)
                    end

                    ItemESP:Clean(Services.CollectionService:GetInstanceAddedSignal("beehive"):Connect(Hive))
                end

                local function Removed(Item: Instance)
                    if Tags[Item] then
                        Boxes.Destroy(Tags[Item].Slot)
                        Tags[Item] = nil
                    end
                end

                ItemESP:Clean(Services.CollectionService:GetInstanceRemovedSignal("ItemDrop"):Connect(Removed))
                ItemESP:Clean(Services.CollectionService:GetInstanceRemovedSignal("block"):Connect(Removed))
                ItemESP:Clean(Services.CollectionService:GetInstanceRemovedSignal("beehive"):Connect(Removed))

                ItemESP:Clean(Services.RunService.PreRender:Connect(function()
                    local Camera: Camera = Services.Workspace.CurrentCamera
                    local LocalPosition: Vector3? = Entity.Alive and Entity.RootPart.Position or nil
                    local Lines: Color3 = Color3.fromHSV(BoxColor.Hue, BoxColor.Sat, BoxColor.Value)
                    for Item: Instance, Tag: any in Tags do
                        if Item.Parent then
                            local Position: Vector3 = (Item :: BasePart).Position
                            local Allowed: boolean = Position.Y > -200 and (Tag.Kind ~= "Trap" or Mine.Enabled or not IsMine(Item))
                            local Area: {number}? = Allowed and Bounds(Item :: BasePart, Camera) or nil
                            local Show: boolean = Area ~= nil
                            local Pic: boolean = Icons.Enabled and Tag.Image ~= nil
                            local Slot: Box = Tag.Slot

                            if Show then
                                local Bees: boolean = Tag.Kind == "Hive"
                                local Amount: number = if Bees then Item:GetAttribute("Level") or 0 else Item:GetAttribute("Amount") or 1
                                local Gap: number? = Distance.Enabled and (LocalPosition and math.floor((LocalPosition - Position).Magnitude) or 0) or nil
                                if Tag.Amount ~= Amount or Tag.Distance ~= Gap or Tag.Pic ~= Pic then
                                    Tag.Amount, Tag.Distance, Tag.Pic = Amount, Gap, Pic
                                    Tag.Width = Pic and 28 or Cat.Ui:Measure(Tag.Name, 14, Font).X + 10
                                    Slot.Name.Text = Tag.Name
                                    Slot.Vitals.Text = if Bees then `{Amount} {Amount == 1 and "bee" or "bees"}` elseif Amount >= 2 then `x{Amount}` else ""
                                    Slot.Distance.Text = Gap and `{Gap}m` or ""
                                end

                                local Size: number = 28 * Scale.Value
                                local Half: number = (Tag.Width / 2 - 5) * Scale.Value
                                local Edges: {number} = Area :: {number}
                                local Screen: Vector2 = Vector2.new((Edges[1] + Edges[3]) / 2, Edges[2] - math.max(Size, 20 * Scale.Value) / 2 - 2)
                                Slot.Name.Visible = not Pic
                                Slot.Name.Position = Vector2.new(Screen.X, Screen.Y)
                                Slot.Distance.Visible = Gap ~= nil
                                Slot.Distance.Position = Vector2.new(Screen.X - Half, Screen.Y)
                                Slot.Vitals.Visible = Bees or Amount >= 2
                                Slot.Vitals.Position = Vector2.new(Screen.X + Half, Screen.Y)

                                local Icon: ImageLabel = Slot.Icons[1]
                                Icon.Visible = Pic
                                Icon.Size = UDim2.fromOffset(Size, Size)
                                Icon.Position = UDim2.fromOffset(math.floor(Screen.X - Size / 2), math.floor(Screen.Y + Size / 2))
                            elseif Tag.Shown then
                                Boxes.Hide(Slot)
                            end
                            Tag.Shown = Show

                            if (Area and BoxToggle.Enabled) or Slot.Used > 0 then
                                Draw(Slot, Lines, BoxToggle.Enabled and Area or nil)
                            end
                        else
                            Tags[Item] = nil
                            Boxes.Destroy(Tag.Slot)
                        end
                    end
                end))
            else
                for _, v: any in Tags do
                    Boxes.Destroy(v.Slot)
                end

                table.clear(Tags)
            end
        end,
        Tooltip = "Renders tags over dropped items, and optionally traps and pots"
    })

    Distance = ItemESP:CreateToggle({
        Name = "Distance",
        Tooltip = "Shows the distance of the item"
    })
    Shadow = ItemESP:CreateToggle({
        Name = "Text shadow",
        Default = true,
        Function = function()
            for _, Tag: any in Tags do
                Style(Tag)
            end
        end,
        Tooltip = "Draws a dark copy of the text behind it so it reads on bright floors"
    })
    Scale = ItemESP:CreateSlider({
        Name = "Scale",
        Min = 0.1,
        Max = 1.5,
        Default = 1,
        Decimal = 10,
        Function = function(Value: number)
            for _, Tag: any in Tags do
                Tag.Slot.Name.Scale = Value
                Tag.Slot.Distance.Scale = Value
                Tag.Slot.Vitals.Scale = Value
            end
        end
    })
    TextColor = ItemESP:CreateColorSlider({
        Name = "Text color",
        DefaultSat = 0,
        Function = function(Hue: number, Sat: number, Val: number)
            for _, Tag: any in Tags do
                Tag.Slot.Name.Color = Color3.fromHSV(Hue, Sat, Val)
                Tag.Slot.Vitals.Color = Color3.fromHSV(Hue, Sat, Val)
            end
        end
    })
    Icons = ItemESP:CreateToggle({
        Name = "Icons",
        Function = function()
            for _, Tag: any in Tags do
                Tag.Pic = nil
            end
        end,
        Tooltip = "Shows the item icon instead of its name"
    })
    Traps = ItemESP:CreateToggle({
        Name = "Traps",
        Function = function(Callback: boolean)
            if Mine and Mine.Object then
                Mine.Object.Visible = Callback
            end

            if TrapList and TrapList.Object then
                TrapList.Object.Visible = Callback
            end

            Restart()
        end,
        Tooltip = "Also shows traps and landmines, which have no visual at all"
    })
    Mine = ItemESP:CreateToggle({
        Name = "Your traps",
        Default = true,
        Darker = true,
        Visible = Traps.Enabled,
        Tooltip = "Also shows the ones your own team placed"
    })
    TrapList = ItemESP:CreateTextList({
        Name = "Trap list",
        Function = Restart,
        Default = {
            "Gloop",
            "Grave",
            "Landmine",
            "Lucky Trap",
            "Snap Trap",
            "Spikes",
            "Tesla"
        },
        Darker = true,
        Visible = Traps.Enabled
    })
    Pots = ItemESP:CreateToggle({
        Name = "Pots",
        Function = Restart,
        Tooltip = "Also shows desert pots"
    })
    Hives = ItemESP:CreateToggle({
        Name = "Beehives",
        Function = Restart,
        Tooltip = "Also shows beehives with their owner and how many bees are in them"
    })
    BoxToggle = ItemESP:CreateToggle({
        Name = "Boxes",
        Function = function(Callback: boolean)
            if BoxStyle and BoxStyle.Object then
                BoxStyle.Object.Visible = Callback
            end
        end,
        Tooltip = "Draws a box around each entry"
    })
    BoxStyle = ItemESP:CreateDropdown({
        Name = "Box style",
        List = {"Corners", "Full", "Rounded"},
        Default = "Corners",
        Darker = true,
        Visible = BoxToggle.Enabled
    })
    BoxColor = ItemESP:CreateColorSlider({
        Name = "Box color",
        DefaultSat = 0
    })
    Whitelist = ItemESP:CreateTextList({
        Name = "Allowed items",
        Function = Restart,
        Darker = true,
        Tooltip = "Only shows the items in this list, by name or item id.\nLeave it empty to show every item"
    })

    Cat:Clean(function()
        for _, v: any in Tags do
            Boxes.Destroy(v.Slot)
        end

        table.clear(Tags)
    end)
end)()

BundledModules.KitDisplay = (function()
    local Cat = BundledModules.UI.Cat
    local UI = BundledModules.UI

    local Services = BundledModules.Services

    local KitDisplay
    local ShowPrevious

    local Histories: {[number]: {string}} = {}
    local Fetching: {[number]: boolean} = {}
    local Thumbnails: {[number]: string} = {}
    local Connections: {[Instance]: {RBXScriptConnection}} = {}

    local function GetPlayer(Entry: Instance, Name: string): Player?
        for _, v: Player in Services.Players:GetPlayers() do
            if v.Name == Name or v.DisplayName == Name or v:GetAttribute("DisguiseDisplayName") == Name then
                return v
            end
        end

        if type(Data.Controllers.StreamerModeController.getDisplayName) == "function" then
            for _, v: Player in Services.Players:GetPlayers() do
                local Success: boolean, DisplayName: any = pcall(
                    Data.Controllers.StreamerModeController.getDisplayName,
                    Data.Controllers.StreamerModeController,
                    v
                )
                if Success and DisplayName == Name then
                    return v
                end
            end
        end

        local PlayerRender: Instance? = Entry:FindFirstChild("PlayerRender", true)
        if PlayerRender and PlayerRender:IsA("ImageLabel") and PlayerRender.Image ~= "" then
            for _, v: Player in Services.Players:GetPlayers() do
                if not Thumbnails[v.UserId] then
                    local Success: boolean, Thumbnail: string, Ready: boolean = pcall(
                        Services.Players.GetUserThumbnailAsync,
                        Services.Players,
                        v.UserId,
                        Enum.ThumbnailType.HeadShot,
                        Enum.ThumbnailSize.Size352x352
                    )
                    if Success and Ready then
                        Thumbnails[v.UserId] = Thumbnail
                    end
                end
                if Thumbnails[v.UserId] == PlayerRender.Image then
                    return v
                end
            end
        end

        if Name == Entry:GetAttribute("KitDisplayOriginalName") then
            return Services.Players:GetPlayerByUserId(Entry:GetAttribute("KitDisplayUserId") or 0)
        end
        return nil
    end

    local function GetPreviousKits(Player: Player): {string}
        local UserId: number = Player.UserId
        if Histories[UserId] then
            return Histories[UserId]
        end

        local Deadline: number = os.clock() + 15
        repeat
            if not Fetching[UserId] then
                break
            end
            if not KitDisplay.Enabled or os.clock() >= Deadline then
                return {}
            end
            task.wait()
        until false
        if Histories[UserId] then
            return Histories[UserId]
        end

        Fetching[UserId] = true
        local Success: boolean, Kits: any = pcall(function(): {string}?
            local Result: any = Data.Controllers.ClientScript:Get("RequestMatchHistory"):CallServer(Player.Name)
            if type(Result) ~= "table" or type(Result.matchHistory) ~= "table" then
                return nil
            end

            local List: {string} = {}
            table.sort(Result.matchHistory, function(A: any, B: any): boolean
                return (tonumber(A.matchStartTime) or 0) > (tonumber(B.matchStartTime) or 0)
            end)
            for i: number, Match: any in Result.matchHistory do
                if i > 8 then
                    break
                end
                local Kit: string = "none"
                for _, MatchPlayer: any in Match.players or {} do
                    if MatchPlayer.playerInfo and MatchPlayer.playerInfo.userId == UserId then
                        local Stats: any = MatchPlayer["bedwars"]
                        Kit = Stats and Stats.kit or "none"
                        break
                    end
                end
                table.insert(List, Kit)
            end
            return List
        end)
        Fetching[UserId] = nil

        if Success and type(Kits) == "table" then
            Histories[UserId] = Kits
            return Kits
        end
        return {}
    end

    local function RenderPreviousKits(Card: Instance, Player: Player): ()
        local Old: Instance? = Card:FindFirstChild("PreviousKits")
        if Old then
            Old:Destroy()
        end

        if ShowPrevious.Enabled then
            local Holder: Frame = Instance.new("Frame")
            Holder.Name = "PreviousKits"
            Holder.AnchorPoint = Vector2.new(0.5, 0)
            Holder.Position = UDim2.fromScale(0.5, 0.03)
            Holder.Size = UDim2.fromScale(0.86, 0.24)
            Holder.BackgroundTransparency = 1
            Holder.BorderSizePixel = 0
            Holder.ClipsDescendants = true
            Holder.ZIndex = 3
            Holder.Parent = Card
            KitDisplay:Clean(Holder)

            local Corner: UICorner = Instance.new("UICorner")
            Corner.CornerRadius = UDim.new(0, 4)
            Corner.Parent = Holder

            local Padding: UIPadding = Instance.new("UIPadding")
            Padding.PaddingLeft = UDim.new(0, 3)
            Padding.PaddingRight = UDim.new(0, 3)
            Padding.Parent = Holder

            local Layout: UIListLayout = Instance.new("UIListLayout")
            Layout.FillDirection = Enum.FillDirection.Horizontal
            Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            Layout.VerticalAlignment = Enum.VerticalAlignment.Center
            Layout.Padding = UDim.new(0, 2)
            Layout.SortOrder = Enum.SortOrder.LayoutOrder
            Layout.Parent = Holder

            local Kits: {string} = GetPreviousKits(Player)
            if KitDisplay.Enabled and ShowPrevious.Enabled and Holder.Parent then
                if #Kits == 0 then
                    Holder:Destroy()
                else
                    for i: number, Kit: string in Kits do
                        local Meta: any = Data.Instances.BedwarsKitMeta[string.split(Kit, ",")[1]]
                            or Data.Instances.BedwarsKitMeta.none

                        local Icon: ImageLabel = Instance.new("ImageLabel")
                        Icon.Name = `Kit{i}`
                        Icon.LayoutOrder = i
                        Icon.Size = UDim2.fromScale(1, 1)
                        Icon.SizeConstraint = Enum.SizeConstraint.RelativeYY
                        Icon.BackgroundTransparency = 1
                        Icon.Image = Meta and Meta.renderImage or ""
                        Icon.ScaleType = Enum.ScaleType.Fit
                        Icon.ZIndex = 4
                        Icon.Parent = Holder

                        local Order: TextLabel = Instance.new("TextLabel")
                        Order.Name = "Order"
                        Order.Position = UDim2.fromOffset(1, 1)
                        Order.Size = UDim2.fromOffset(13, 13)
                        Order.BackgroundColor3 = Color3.new()
                        Order.BackgroundTransparency = 1
                        Order.BorderSizePixel = 0
                        Order.FontFace = UI.Font
                        Order.Text = tostring(i)
                        Order.TextColor3 = Color3.new(1, 1, 1)
                        Order.TextSize = 9
                        Order.ZIndex = 5
                        Order.Parent = Icon

                        local OrderCorner: UICorner = Instance.new("UICorner")
                        OrderCorner.CornerRadius = UDim.new(0, 4)
                        OrderCorner.Parent = Order
                    end
                end
            end
        end
    end

    local function SetKit(Image: ImageLabel, Player: Player): ()
        local Meta: any = Data.Instances.BedwarsKitMeta[string.split(Player:GetAttribute("PlayingAsKits") or "none", ",")[1]]
            or Data.Instances.BedwarsKitMeta.none
        Image.Image = Meta and Meta.renderImage or ""
        Image.Position = UDim2.fromScale(1.05, 0)
        Services.TweenService:Create(Image, TweenInfo.new(0.2, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {
            Position = UDim2.fromScale(1.05, 0.5)
        }):Play()
    end

    local function RenderKit(Entry: Instance): ()
        task.wait(0.3)

        local PlayerName: Instance? = Entry:FindFirstChild("PlayerName", true)
        if not KitDisplay.Enabled or not Entry.Parent or not PlayerName then
            return
        end

        local OriginalName: string = PlayerName:GetAttribute("NickHiderOriginalText") or PlayerName.Text
        local Player: Player? = GetPlayer(Entry, OriginalName)
        if not KitDisplay.Enabled or not Entry.Parent or not Player then
            return
        end

        local Frame: Instance? = Entry:FindFirstChild("1")
        local Card: Instance? = Frame and Frame:FindFirstChild("MatchDraftPlayerCard")
        if not Card then
            return
        end

        for _, Connection: RBXScriptConnection in Connections[Entry] or {} do
            Connection:Disconnect()
        end

        local Image: any = Card:FindFirstChild("KitImage")
        if not Image then
            Image = Instance.new("ImageLabel")
            Image.BackgroundTransparency = 1
            Image.AnchorPoint = Vector2.new(1, 0.5)
            Image.Position = UDim2.fromScale(1.05, 0)
            Image.Name = "KitImage"
            Image.Size = UDim2.fromScale(1.5, 1.5)
            Image.ZIndex = 1
            Image.ImageTransparency = 0.4
            Image.SliceCenter = Rect.new(0, 0, 0, 0)
            Image.SliceScale = 1
            Image.ScaleType = Enum.ScaleType.Crop
            Image.Parent = Card
            KitDisplay:Clean(Image)

            local Ratio: UIAspectRatioConstraint = Instance.new("UIAspectRatioConstraint")
            Ratio.Name = "1"
            Ratio.AspectRatio = 1
            Ratio.AspectType = Enum.AspectType.FitWithinMaxSize
            Ratio.DominantAxis = Enum.DominantAxis.Width
            Ratio.Parent = Image
        end

        SetKit(Image, Player)
        task.spawn(RenderPreviousKits, Card, Player)

        Entry:SetAttribute("KitDisplayUserId", Player.UserId)
        Entry:SetAttribute("KitDisplayOriginalName", OriginalName)

        local Connection: RBXScriptConnection? = Player:GetAttributeChangedSignal("PlayingAsKits"):Connect(function(): ()
            if KitDisplay.Enabled and Image.Parent then
                SetKit(Image, Player)
            end
        end)
        local NameConnection: RBXScriptConnection = PlayerName:GetPropertyChangedSignal("Text"):Once(function(): ()
            if Connection then
                Connection:Disconnect()
                Connection = nil
            end
            RenderKit(Entry)
        end)
        Connections[Entry] = {Connection, NameConnection}
        KitDisplay:Clean(NameConnection)
        KitDisplay:Clean(Connection)
    end

    KitDisplay = Cat.Categories.Render:CreateModule({
        Name = "KitDisplay",
        Function = function(Callback: boolean)
            if Callback then
                KitDisplay:Clean(function(): ()
                    table.clear(Connections)
                    table.clear(Histories)
                    table.clear(Fetching)
                    table.clear(Thumbnails)
                end)

                local BodyContainer: Instance?
                repeat
                    local App: Instance? = Services.LocalPlayer.PlayerGui:FindFirstChild("MatchDraftApp")
                    local Background: Instance? = App and App:FindFirstChild("DraftAppBackground")
                    local Frame: Instance? = Background and Background:FindFirstChild("1")
                    BodyContainer = Frame and Frame:FindFirstChild("BodyContainer")
                    if not BodyContainer then
                        task.wait(0.1)
                    end
                until BodyContainer or not KitDisplay.Enabled

                if KitDisplay.Enabled and BodyContainer then
                    for Team: number = 1, 2 do
                        if KitDisplay.Enabled then
                            local Column: Instance?
                            local Deadline: number = os.clock() + 10
                            repeat
                                Column = BodyContainer:FindFirstChild(`Team{Team}Column`)
                                if not Column then
                                    task.wait(0.1)
                                end
                            until Column or not KitDisplay.Enabled or os.clock() >= Deadline

                            if Column then
                                KitDisplay:Clean(Column.ChildAdded:Connect(RenderKit))
                                for _, v: Instance in Column:GetChildren() do
                                    task.spawn(RenderKit, v)
                                end
                            end
                        end
                    end
                end
            end
        end,
        Tooltip = "Lets you see everyone's kit in the match draft"
    })

    ShowPrevious = KitDisplay:CreateToggle({
        Name = "Show previous kits",
        Function = function(): ()
            if KitDisplay.Enabled then
                KitDisplay:Toggle()
                KitDisplay:Toggle()
            end
        end,
        Default = true,
        Tooltip = "Shows the kits each player used in their last 8 games, newest first"
    })
end)()

BundledModules.KitESP = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services

    local KitESP
    local Background, Color, Scale

    local Reference: {[Instance]: ImageLabel} = {}
    local Connections: {RBXScriptConnection} = {}

    local Folder: Folder = Instance.new("Folder")
    Folder.Parent = Cat.Ui.Gui

    local ESPKits: {[string]: {string}} = {
        alchemist = {"alchemist_ingedients", "wild_flower"},
        beekeeper = {"bee", "bee"},
        bigman = {"treeOrb", "natures_essence_1"},
        ghost_catcher = {"ghost", "ghost_orb"},
        metal_detector = {"hidden-metal", "iron"},
        sheep_herder = {"SheepModel", "purple_hay_bale"},
        sorcerer = {"alchemy_crystal", "wild_flower"},
        star_collector = {"stars", "crit_star"}
    }

    local function GetPart(Ent: Instance): BasePart?
        if Ent:IsA("BasePart") then
            return Ent
        end
        if Ent:IsA("Model") then
            return Ent.PrimaryPart or Ent:FindFirstChild("Root") or Ent:FindFirstChildWhichIsA("BasePart", true)
        end

        return Ent:FindFirstChildWhichIsA("BasePart", true)
    end

    local function Added(Ent: Instance, Icon: string)
        if not Reference[Ent] then
            local Part: BasePart? = GetPart(Ent)
            if Part then
                local Billboard: BillboardGui = Instance.new("BillboardGui")
                Billboard.Name = Icon
                Billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
                Billboard.Size = UDim2.fromOffset(36 * Scale.Value, 36 * Scale.Value)
                Billboard.AlwaysOnTop = true
                Billboard.ClipsDescendants = false
                Billboard.Adornee = Part
                Billboard.Parent = Folder

                local Image: ImageLabel = Instance.new("ImageLabel")
                Image.Name = "Image"
                Image.Size = UDim2.fromScale(1, 1)
                Image.BackgroundColor3 = Color3.fromHSV(Color.Hue, Color.Sat, Color.Value)
                Image.BackgroundTransparency = 1 - (Background.Enabled and Color.Opacity or 0)
                Image.BorderSizePixel = 0
                Image.Image = Data.Instances.Items[Icon] and Data.Instances.Items[Icon].image or ""
                Image.Parent = Billboard

                local Shadow: UIShadow = Instance.new("UIShadow")
                Shadow.BlurRadius = UDim.new(0, 13)
                Shadow.Transparency = 0.25
                Shadow.Enabled = Background.Enabled
                Shadow.Parent = Image

                local Corner: UICorner = Instance.new("UICorner")
                Corner.CornerRadius = UDim.new(0, 4)
                Corner.Parent = Image

                Reference[Ent] = Image
            else
                task.spawn(function()
                    local Deadline: number = os.clock() + 10
                    local Found: BasePart?
                    repeat
                        task.wait(0.25)
                        Found = GetPart(Ent)
                    until Found or not Ent.Parent or os.clock() > Deadline or not KitESP.Enabled

                    if Found and Ent.Parent and KitESP.Enabled and not Reference[Ent] then
                        Added(Ent, Icon)
                    end
                end)
            end
        end
    end

    local function Watch(Kit: {string})
        table.insert(Connections, Services.CollectionService:GetInstanceAddedSignal(Kit[1]):Connect(function(Ent: Instance)
            Added(Ent, Kit[2])
        end))
        table.insert(Connections, Services.CollectionService:GetInstanceRemovedSignal(Kit[1]):Connect(function(Ent: Instance)
            if Reference[Ent] then
                (Reference[Ent].Parent :: Instance):Destroy()
                Reference[Ent] = nil
            end
        end))

        for _, v: Instance in Services.CollectionService:GetTagged(Kit[1]) do
            Added(v, Kit[2])
        end
    end

    KitESP = Cat.Categories.Render:CreateModule({
        Name = "KitESP",
        Function = function(Callback: boolean)
            if not Callback then
                return
            end

            KitESP:Clean(function()
                for _, v: RBXScriptConnection in Connections do
                    v:Disconnect()
                end

                table.clear(Connections)
                table.clear(Reference)
                Folder:ClearAllChildren()
            end)

            local Current: string?
            repeat
                local Kits: {string} = {}
                local Attribute: any = Services.LocalPlayer:GetAttribute("PlayingAsKits")
                local Joined: string = `{Data.Storage.EquippedKit},{typeof(Attribute) == "string" and Attribute or ""}`
                for _, v: string in string.split(Joined, ",") do
                    if v ~= "" and v ~= "none" and not table.find(Kits, v) then
                        table.insert(Kits, v)
                    end
                end

                local Key: string = table.concat(Kits, ",")
                if Key ~= Current then
                    Current = Key
                    for _, v: RBXScriptConnection in Connections do
                        v:Disconnect()
                    end

                    table.clear(Connections)
                    table.clear(Reference)
                    Folder:ClearAllChildren()

                    for _, v: string in Kits do
                        if ESPKits[v] then
                            Watch(ESPKits[v])
                        end
                    end
                end

                task.wait(1)
            until not KitESP.Enabled
        end,
        Tooltip = "Shows icons on kit related objects, for every kit you have (both kits in Kit Fusion)"
    })

    Background = KitESP:CreateToggle({
        Name = "Background",
        Function = function(Callback: boolean)
            if Color then
                Color.Object.Visible = Callback
            end

            for _, v: ImageLabel in Reference do
                v.BackgroundTransparency = 1 - (Callback and Color.Opacity or 0)
                v:FindFirstChildOfClass("UIShadow").Enabled = Callback
            end
        end,
        Default = true
    })
    Color = KitESP:CreateColorSlider({
        Name = "Background Color",
        DefaultValue = 0,
        DefaultOpacity = 0.5,
        Visible = Background.Enabled,
        Function = function(Hue: number, Sat: number, Val: number, Opacity: number)
            for _, v: ImageLabel in Reference do
                v.BackgroundColor3 = Color3.fromHSV(Hue, Sat, Val)
                v.BackgroundTransparency = 1 - (Background.Enabled and Opacity or 0)
            end
        end,
        Darker = true
    })
    Scale = KitESP:CreateSlider({
        Name = "Scale",
        Function = function(Value: number)
            for _, v: ImageLabel in Reference do
                (v.Parent :: BillboardGui).Size = UDim2.fromOffset(36 * Value, 36 * Value)
            end
        end,
        Default = 1,
        Min = 0.1,
        Max = 1.5,
        Decimal = 10
    })
end)()

BundledModules.Weather = (function()
    local Cat = BundledModules.UI.Cat

    local Services = BundledModules.Services
    local getcustomasset: (string) -> string = BundledModules.getcustomasset
    local isfile: (string) -> boolean = BundledModules.isfile

    local Slots: number = 24
    local Params: RaycastParams = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.RespectCanCollide = true

    local function Texture(Name: string, Fallback: string?): string?
        local Path: string = `catvape/assets/weather/{Name}.png`
        local Success: boolean, Result: any = pcall(function()
            return isfile(Path) and getcustomasset(Path)
        end)
        if Success and Result then
            return Result
        end

        warn(`[catvape] Weather: {Name}.png is missing or won't load, {Fallback and "using a fallback texture" or "skipping that layer"}`)

        return Fallback
    end

    return function(): Weather
        local Weather: Weather
        local Folder: Folder
        local Flash: ColorCorrectionEffect
        local LensFrame: Frame
        local NearPart: Part, FarPart: Part, MistPart: Part
        local Rain: ParticleEmitter, Veil: ParticleEmitter, Mist: ParticleEmitter
        local Loops: {Sound} = {}
        local Equalizers: {EqualizerSoundEffect} = {}
        local Shots: {Sound} = {}
        local Splashes: {ParticleEmitter} = {}
        local Ripples: {ParticleEmitter} = {}
        local Bolts: {Part} = {}
        local Drops: {ImageLabel} = {}
        local Level: number = 0.7
        local ThunderOn: boolean, LensOn: boolean, HasLens: boolean = true, true, false
        local Covered: boolean, Muffled: boolean = false, false
        local NearRate: number = 0
        local Version: number = 0

        local function Build(): ()
            local Streak: string = Texture("streak", "rbxassetid://17737615358") :: string
            local Puff: string = Texture("mist", "rbxasset://textures/particles/smoke_main.dds") :: string
            local SplashImage: string? = Texture("splash", nil)
            local RippleImage: string? = Texture("ripple", nil)
            local LensImage: string? = Texture("lens", nil)
            HasLens = LensImage ~= nil

            Folder = Instance.new("Folder")
            Folder.Name = "Weather"
            Cat:Clean(Folder)
            Cat:Clean(function(): ()
                Version += 1
            end)

            local Made: {Part} = {}
            for Index: number, Size: Vector3 in {Vector3.new(170, 1, 170), Vector3.new(800, 1, 800), Vector3.new(220, 2, 220), Vector3.new(1, 1, 1)} do
                local Part: Part = Instance.new("Part")
                Part.Name = "Layer"
                Part.Anchored = true
                Part.CanCollide = false
                Part.CanQuery = false
                Part.CanTouch = false
                Part.CastShadow = false
                Part.Transparency = 1
                Part.Size = Size
                Part.Parent = Folder
                Made[Index] = Part
            end
            NearPart, FarPart, MistPart = Made[1], Made[2], Made[3]

            Rain = Instance.new("ParticleEmitter")
            Rain.Texture = Streak
            Rain.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
            Rain.EmissionDirection = Enum.NormalId.Bottom
            Rain.Speed = NumberRange.new(130, 160)
            Rain.Lifetime = NumberRange.new(0.36, 0.4)
            Rain.SpreadAngle = Vector2.new(1.5, 1.5)
            Rain.Acceleration = Vector3.new(6, 0, 2)
            Rain.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 3.5, 0.8), NumberSequenceKeypoint.new(1, 3.5, 0.8)})
            Rain.Transparency = NumberSequence.new(0.1)
            Rain.LightInfluence = 0.4
            Rain.LightEmission = 0.6
            Rain.Rate = 0
            Rain.Enabled = false
            Rain.Parent = NearPart

            Veil = Instance.new("ParticleEmitter")
            Veil.Texture = Streak
            Veil.Orientation = Enum.ParticleOrientation.FacingCameraWorldUp
            Veil.EmissionDirection = Enum.NormalId.Bottom
            Veil.Speed = NumberRange.new(150, 170)
            Veil.Lifetime = NumberRange.new(0.8, 0.88)
            Veil.SpreadAngle = Vector2.new(1.5, 1.5)
            Veil.Acceleration = Vector3.new(6, 0, 2)
            Veil.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 7, 1.5), NumberSequenceKeypoint.new(1, 7, 1.5)})
            Veil.Transparency = NumberSequence.new(0.4)
            Veil.LightInfluence = 0.4
            Veil.LightEmission = 0.6
            Veil.Rate = 0
            Veil.Enabled = false
            Veil.Parent = FarPart

            Mist = Instance.new("ParticleEmitter")
            Mist.Texture = Puff
            Mist.EmissionDirection = Enum.NormalId.Top
            Mist.Speed = NumberRange.new(0.5, 2)
            Mist.Lifetime = NumberRange.new(6, 9)
            Mist.Drag = 0.5
            Mist.Rotation = NumberRange.new(0, 360)
            Mist.RotSpeed = NumberRange.new(-8, 8)
            Mist.Color = ColorSequence.new(Color3.fromRGB(120, 130, 146))
            Mist.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 18), NumberSequenceKeypoint.new(1, 40)})
            Mist.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.2, 0.95), NumberSequenceKeypoint.new(0.8, 0.96), NumberSequenceKeypoint.new(1, 1)})
            Mist.LightInfluence = 1
            Mist.LightEmission = 0
            Mist.Rate = 0
            Mist.Enabled = false
            Mist.Parent = MistPart

            for Index: number = 1, Slots do
                if SplashImage then
                    local Pad: Attachment = Instance.new("Attachment")
                    Pad.Name = "Splash"
                    Pad.Parent = Made[4]

                    local Splash: ParticleEmitter = Instance.new("ParticleEmitter")
                    Splash.Texture = SplashImage
                    Splash.FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4
                    Splash.FlipbookMode = Enum.ParticleFlipbookMode.OneShot
                    Splash.Lifetime = NumberRange.new(0.35, 0.4)
                    Splash.Speed = NumberRange.new(0)
                    Splash.Size = NumberSequence.new(1.4)
                    Splash.Transparency = NumberSequence.new(0.2)
                    Splash.LightInfluence = 1
                    Splash.LightEmission = 0
                    Splash.Rate = 0
                    Splash.Enabled = false
                    Splash.Parent = Pad
                    Splashes[Index] = Splash
                end
                if RippleImage then
                    local Pad: Attachment = Instance.new("Attachment")
                    Pad.Name = "Ripple"
                    Pad.Parent = Made[4]

                    local Ripple: ParticleEmitter = Instance.new("ParticleEmitter")
                    Ripple.Texture = RippleImage
                    Ripple.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
                    Ripple.EmissionDirection = Enum.NormalId.Top
                    Ripple.Lifetime = NumberRange.new(0.6, 0.65)
                    Ripple.Speed = NumberRange.new(0.05)
                    Ripple.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1.7)})
                    Ripple.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(0.6, 0.6), NumberSequenceKeypoint.new(1, 1)})
                    Ripple.LightInfluence = 1
                    Ripple.LightEmission = 0
                    Ripple.Rate = 0
                    Ripple.Enabled = false
                    Ripple.Parent = Pad
                    Ripples[Index] = Ripple
                end
            end

            for Index: number, Name: string in {"PIRATE_EVENT_RAIN_LOOP", "WIND_AMBIENCE", "LIGHTNING_THUNDER_STORM_LOOP"} do
                local Loop: Sound = Instance.new("Sound")
                Loop.Name = Name
                Loop.SoundId = Data.Instances.Sounds[Name]
                Loop.Looped = true
                Loop.Volume = 0

                local Equalizer: EqualizerSoundEffect = Instance.new("EqualizerSoundEffect")
                Equalizer.Name = "EQ"
                Equalizer.Parent = Loop
                Loop.Parent = Folder
                Loops[Index] = Loop
                Equalizers[Index] = Equalizer
            end
            for Index: number, Name: string in {"LIGHTNING_STRIKE_1", "LIGHTNING_STRIKE_2", "PIRATE_EVENT_THUNDER", "PIRATE_EVENT_THUNDER"} do
                local Shot: Sound = Instance.new("Sound")
                Shot.Name = Name
                Shot.SoundId = Data.Instances.Sounds[Name]

                local Equalizer: EqualizerSoundEffect = Instance.new("EqualizerSoundEffect")
                Equalizer.Name = "EQ"
                Equalizer.Parent = Shot
                Shot.Parent = Folder
                Shots[Index] = Shot
            end
            task.spawn(function(): ()
                pcall(function(): ()
                    Services.ContentProvider:PreloadAsync(Shots)
                end)
            end)

            for Index: number = 1, 40 do
                local Bolt: Part = Instance.new("Part")
                Bolt.Name = "Bolt"
                Bolt.Anchored = true
                Bolt.CanCollide = false
                Bolt.CanQuery = false
                Bolt.CanTouch = false
                Bolt.CastShadow = false
                Bolt.Material = Enum.Material.Neon
                Bolt.Color = Color3.fromRGB(200, 220, 255)
                Bolt.Transparency = 1
                Bolt.Parent = Folder
                Bolts[Index] = Bolt
            end

            Flash = Instance.new("ColorCorrectionEffect")
            Flash.Name = "WeatherFlash"
            Flash.Brightness = 0
            Cat:Clean(Flash)

            LensFrame = Instance.new("Frame")
            LensFrame.Name = "WeatherLens"
            LensFrame.Size = UDim2.fromScale(1, 1)
            LensFrame.BackgroundTransparency = 1
            LensFrame.BorderSizePixel = 0
            LensFrame.ZIndex = -100
            LensFrame.Interactable = false
            Cat:Clean(LensFrame)
            for Index: number = 1, 10 do
                local Drop: ImageLabel = Instance.new("ImageLabel")
                Drop.Name = "Drop"
                Drop.AnchorPoint = Vector2.new(0.5, 0.5)
                Drop.BackgroundTransparency = 1
                Drop.BorderSizePixel = 0
                Drop.Image = LensImage or ""
                Drop.ImageRectSize = Vector2.new(256, 256)
                Drop.ImageTransparency = 1
                Drop.Visible = false
                Drop.Parent = LensFrame
                Drops[Index] = Drop
            end
        end

        local function Apply(): ()
            Veil.Rate = 1200 * Level
            Mist.Rate = 12 * Level
            LensFrame.Parent = (LensOn and HasLens) and Cat.Ui.Gui or nil

            local Volumes: {number} = {0.6 * Level, 0.35, ThunderOn and 0.25 or 0}
            for Index: number, v: Sound in Loops do
                Services.TweenService:Create(v, TweenInfo.new(2), {Volume = Volumes[Index]}):Play()
            end
        end

        local function Drip(Camera: Camera): ()
            local Label: ImageLabel?
            for _, v: ImageLabel in Drops do
                if not v.Visible then
                    Label = v
                    break
                end
            end

            if Label then
                local Slide: number = math.random(40, 160)
                local Length: number = 1.5 + math.random() * 1.5
                local Size: number = math.random(18, 48) * Camera.ViewportSize.Y / 720
                local X: number, Y: number
                repeat
                    X, Y = math.random(), math.random()
                until math.abs(X - 0.5) > 0.22 or Y > 0.72 or Y + Slide / Camera.ViewportSize.Y < 0.28

                Label.Position = UDim2.fromScale(X, Y)
                Label.Size = UDim2.fromOffset(Size, Size)
                Label.Rotation = math.random(-12, 12)
                Label.ImageRectOffset = Vector2.new(256 * math.random(0, 1), 256 * math.random(0, 1))
                Label.ImageTransparency = 1
                Label.Visible = true

                local Shown: ImageLabel = Label
                task.spawn(function(): ()
                    Services.TweenService:Create(Shown, TweenInfo.new(0.12), {ImageTransparency = 0.2}):Play()
                    local Glide: TweenInfo = TweenInfo.new(Length, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
                    Services.TweenService:Create(Shown, Glide, {Position = UDim2.new(X, 0, Y, Slide)}):Play()
                    task.wait(Length - 0.5)
                    Services.TweenService:Create(Shown, TweenInfo.new(0.5), {ImageTransparency = 1}):Play()
                    task.wait(0.5)
                    Shown.Visible = false
                end)
            end
        end

        local function Tick(Current: number): ()
            local Slot: number = 0
            repeat
                local Camera: Camera? = Services.Workspace.CurrentCamera
                if Camera then
                    local Origin: Vector3 = Camera.CFrame.Position
                    if Folder.Parent ~= Camera then
                        Folder.Parent = Camera
                    end
                    Params.FilterDescendantsInstances = {Services.Players.LocalPlayer.Character or Folder, Folder}

                    NearPart.CFrame = CFrame.new(Origin + Vector3.new(0, 45, 0)) * CFrame.Angles(0, 0, math.rad(7))
                    FarPart.CFrame = CFrame.new(Origin + Vector3.new(0, 120, 0)) * CFrame.Angles(0, 0, math.rad(7))

                    local Roof: RaycastResult? = Services.Workspace:Raycast(Origin, Vector3.new(0, 250, 0), Params)
                    local Floor: RaycastResult? = Services.Workspace:Raycast(Origin, Vector3.new(0, -300, 0), Params)
                    Covered = Roof ~= nil
                    MistPart.CFrame = CFrame.new(Origin.X, (Floor and Floor.Position.Y or Origin.Y - 8) + 3, Origin.Z)

                    if Covered ~= Muffled then
                        Muffled = Covered
                        local Gains: {HighGain: number, MidGain: number} = {HighGain = Covered and -25 or 0, MidGain = Covered and -8 or 0}
                        for _, v: EqualizerSoundEffect in Equalizers do
                            Services.TweenService:Create(v, TweenInfo.new(0.6), Gains):Play()
                        end
                    end

                    NearRate += ((Covered and 0 or 7000 * Level) - NearRate) * 0.4
                    if math.abs(Rain.Rate - NearRate) > 0.5 then
                        Rain.Rate = NearRate
                    end

                    for _ = 1, math.floor(24 * Level) do
                        local Angle: number = math.random() * math.pi * 2
                        local Radius: number = 80 * math.random() ^ 1.8
                        local Sky: Vector3 = Origin + Vector3.new(math.cos(Angle) * Radius, 60, math.sin(Angle) * Radius)
                        local Hit: RaycastResult? = Services.Workspace:Raycast(Sky, Vector3.new(0, -200, 0), Params)
                        if Hit and Hit.Normal.Y > 0.7 then
                            Slot = Slot % Slots + 1
                            if Splashes[Slot] then
                                (Splashes[Slot].Parent :: Attachment).WorldPosition = Hit.Position + Vector3.new(0, 0.42, 0)
                                Splashes[Slot]:Emit(1)
                            end
                            if Ripples[Slot] then
                                (Ripples[Slot].Parent :: Attachment).WorldPosition = Hit.Position + Vector3.new(0, 0.06, 0)
                                Ripples[Slot]:Emit(1)
                            end
                        end
                    end

                    if LensOn and HasLens and not Covered and math.random() < 0.25 * Level * math.clamp(0.4 + Camera.CFrame.LookVector.Y, 0, 1) then
                        Drip(Camera)
                    end
                end
                task.wait(0.1)
            until Version ~= Current
        end

        local function Strike(Distance: number): ()
            local Current: number = Version
            local Camera: Camera? = Services.Workspace.CurrentCamera
            local Peak: number = math.clamp(0.55 / Distance, 0, 0.6)

            task.spawn(function(): ()
                task.wait(Distance / 0.343)
                if Version == Current then
                    local Rumble: Sound = Shots[Shots[3].Playing and 4 or 3]
                    local Volume: number = 1.2 / (0.6 + Distance) * (Covered and 0.5 or 1)
                    if Distance < 1.5 then
                        local Crack: Sound = Shots[math.random(2)]
                        Crack.Volume = Volume
                        Crack:Play()
                        task.wait(0.4)
                    end

                    (Rumble :: any).EQ.HighGain = Distance < 1.5 and 0 or -6 * Distance
                    Rumble.PlaybackSpeed = Distance < 1.5 and 1 or 0.85 + math.random() * 0.1
                    Rumble.Volume = Volume
                    Rumble:Play()
                end
            end)

            if Distance < 1.8 and Camera then
                local Origin: Vector3 = Camera.CFrame.Position
                local Look: Vector3 = Camera.CFrame.LookVector
                local Flat: Vector3 = Vector3.new(Look.X, 0, Look.Z)
                if Flat.Magnitude < 0.01 then
                    Flat = Vector3.new(0, 0, -1)
                end

                local Aim: Vector3 = CFrame.Angles(0, math.rad(math.random(-70, 70)), 0) * Flat.Unit
                local Spot: Vector3 = Origin + Aim * math.random(300, 900)
                local Hit: RaycastResult? = Services.Workspace:Raycast(Spot + Vector3.new(0, 600, 0), Vector3.new(0, -1200, 0), Params)
                local Ground: Vector3 = Hit and Hit.Position or Vector3.new(Spot.X, Origin.Y - 30, Spot.Z)
                local Points: {Vector3} = {Ground}
                local Used: number = 0
                for Index: number = 1, 24 do
                    local Height: number = Index / 24
                    local Spread: number = math.sin(math.pi * Height) * 28
                    local Jitter: Vector3 = Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1) * Spread
                    table.insert(Points, Ground + Jitter + Vector3.new(0, 500 * Height, 0))
                    Used += 1
                    Bolts[Used].Size = Vector3.new(5, 5, (Points[Index + 1] - Points[Index]).Magnitude)
                    Bolts[Used].CFrame = CFrame.lookAt((Points[Index] + Points[Index + 1]) / 2, Points[Index + 1])
                    Bolts[Used].Transparency = 0
                end
                for _ = 1, 3 do
                    local From: Vector3 = Points[math.random(6, 18)]
                    local Sideways: Vector3 = Vector3.new(math.random(-30, 30), -35, math.random(-30, 30))
                    for _ = 1, 4 do
                        local To: Vector3 = From + Sideways + Vector3.new(math.random(-8, 8), 0, math.random(-8, 8))
                        Used += 1
                        Bolts[Used].Size = Vector3.new(2.5, 2.5, (To - From).Magnitude)
                        Bolts[Used].CFrame = CFrame.lookAt((From + To) / 2, To)
                        Bolts[Used].Transparency = 0
                        From = To
                    end
                end
                task.delay(0.2, function(): ()
                    for _, v: Part in Bolts do
                        v.Transparency = 1
                    end
                end)
            end

            local Flickers: number = math.random(2, 3)
            local Count: number = 0
            repeat
                Count += 1
                Flash.Brightness = Peak
                Flash.TintColor = Color3.fromRGB(225, 235, 255)
                task.wait(0.06)
                Flash.Brightness = 0
                task.wait(math.random(5, 12) / 100)
            until Count >= Flickers or Version ~= Current

            if Version == Current then
                Flash.Brightness = Peak * 0.7
                local Decay: TweenInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                Services.TweenService:Create(Flash, Decay, {Brightness = 0}):Play()
                task.wait(0.4)
            end
            Flash.TintColor = Color3.new(1, 1, 1)
        end

        local function Scheduler(Current: number): ()
            repeat
                task.wait(math.random(8, 25) * (1.5 - Level))
                if Version == Current and ThunderOn then
                    Strike(0.4 + math.random() * 5.6)
                end
            until Version ~= Current
        end

        Weather = {
            Running = false,
            Start = function(Intensity: number, Thunder: boolean, Lens: boolean): ()
                Level, ThunderOn, LensOn = math.clamp(Intensity, 0.1, 1), Thunder, Lens
                if Weather.Running then
                    Apply()
                else
                    if not Folder then
                        Build()
                    end

                    Version += 1
                    Weather.Running = true
                    Covered, Muffled, NearRate = false, false, 0

                    local Current: number = Version
                    Folder.Parent = Services.Workspace.CurrentCamera
                    Flash.Parent = Services.Lighting
                    for _, v: ParticleEmitter in {Rain, Veil, Mist} do
                        v.Enabled = true
                    end
                    for _, v: ParticleEmitter in Splashes do
                        v.Enabled = true
                    end
                    for _, v: ParticleEmitter in Ripples do
                        v.Enabled = true
                    end
                    for Index: number, v: Sound in Loops do
                        Equalizers[Index].HighGain, Equalizers[Index].MidGain = 0, 0
                        v.Volume = 0
                        v:Play()
                    end

                    Apply()
                    task.spawn(Tick, Current)
                    task.spawn(Scheduler, Current)
                end
            end,
            Stop = function(): ()
                if Weather.Running then
                    Version += 1
                    Weather.Running = false

                    local Current: number = Version
                    for _, v: ParticleEmitter in {Rain, Veil, Mist} do
                        v.Rate = 0
                        v.Enabled = false
                    end
                    for _, v: ParticleEmitter in Splashes do
                        v.Enabled = false
                    end
                    for _, v: ParticleEmitter in Ripples do
                        v.Enabled = false
                    end
                    for _, v: Sound in Loops do
                        Services.TweenService:Create(v, TweenInfo.new(1.2), {Volume = 0}):Play()
                    end
                    for _, v: Part in Bolts do
                        v.Transparency = 1
                    end

                    Flash.Brightness = 0
                    if Flash.Parent then
                        Flash.Parent = nil
                    end
                    if LensFrame.Parent then
                        LensFrame.Parent = nil
                    end
                    task.delay(1.3, function(): ()
                        if Version == Current and Folder.Parent then
                            for _, v: Sound in Loops do
                                v:Stop()
                            end
                            for _, v: Sound in Shots do
                                v:Stop()
                            end
                            Folder.Parent = nil
                        end
                    end)
                end
            end,
            Set = function(Intensity: number, Thunder: boolean, Lens: boolean): ()
                Level, ThunderOn, LensOn = math.clamp(Intensity, 0.1, 1), Thunder, Lens
                if Weather.Running then
                    Apply()
                end
            end
        }

        return Weather
    end
end)()

